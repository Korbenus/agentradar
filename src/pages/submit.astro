---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Référencer votre Agent IA | AgentRadar"
  description="Faites auditer et référencer votre solution d'agent IA auprès de plus de 15 000 professionnels et décideurs tech."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-bold text-radar-400 uppercase tracking-wider block mb-2">Pour les Éditeurs de Logiciels</span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        Faites découvrir votre Agent IA
      </h1>
      <p class="mt-4 text-base text-slate-300 leading-relaxed">
        AgentRadar est la référence francophone et européenne des agents autonomes B2B. Obtenez une fiche technique vérifiée et gagnez des utilisateurs qualifiés.
      </p>
    </div>

    <!-- Pricing Options for listing -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Free Option -->
      <div class="p-8 rounded-2xl bg-dark-900 border border-dark-800 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase text-slate-400">Standard</span>
          <h3 class="text-2xl font-bold text-white mt-1">Audit Gratuit</h3>
          <p class="text-xs text-slate-400 mt-2">Votre outil sera audité par notre moteur autonome lors d'une prochaine mise à jour.</p>
          <div class="text-3xl font-extrabold text-white mt-6">0 €</div>

          <ul class="mt-6 space-y-3 text-xs text-slate-300">
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> Fiche dédiée permanente
            </li>
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> Référencement SEO & DoFollow
            </li>
            <li class="flex items-center gap-2 text-slate-500">
              <span>⏳</span> Délai d'audit : 10 à 20 jours
            </li>
          </ul>
        </div>

        <a
          href="#form"
          class="mt-8 block text-center py-3 px-4 rounded-xl bg-dark-800 hover:bg-dark-700 text-white font-semibold text-xs transition"
        >
          Soumettre gratuitement
        </a>
      </div>

      <!-- Paid Fast Track Option -->
      <div class="p-8 rounded-2xl bg-gradient-to-b from-dark-900 via-dark-900 to-emerald-950/30 border border-radar-500/40 shadow-xl shadow-radar-500/5 relative flex flex-col justify-between">
        <div class="absolute -top-3 right-6 px-3 py-1 bg-radar-500 text-black font-bold text-[10px] rounded-full uppercase tracking-wider">
          Recommandé SaaS
        </div>

        <div>
          <span class="text-xs font-bold uppercase text-radar-400">Fast-Track</span>
          <h3 class="text-2xl font-bold text-white mt-1">Express + Featured</h3>
          <p class="text-xs text-slate-300 mt-2">Audit prioritaire en 24h avec mise en avant en page d'accueil pendant 30 jours.</p>
          <div class="text-3xl font-extrabold text-radar-400 mt-6">49 € <span class="text-xs font-normal text-slate-400">paiement unique</span></div>

          <ul class="mt-6 space-y-3 text-xs text-slate-200">
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> Publication garantie sous 24h
            </li>
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> Badge « Sélection de la Rédaction »
            </li>
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> Relais dans notre flux RSS & Newsletter
            </li>
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> Bouton d'action personnalisé direct
            </li>
          </ul>
        </div>

        <a
          href="#form"
          class="mt-8 block text-center py-3 px-4 rounded-xl bg-radar-500 hover:bg-radar-400 text-black font-bold text-xs transition shadow-lg shadow-radar-500/20"
        >
          Choisir le Fast-Track (49 €)
        </a>
      </div>
    </div>

    <!-- Form -->
    <div id="form" class="p-8 sm:p-10 rounded-3xl bg-dark-900/80 border border-dark-800 shadow-2xl">
      <h3 class="text-xl font-bold text-white mb-6">Formulaire de soumission</h3>

      <form action="https://formspree.io/f/placeholder" method="POST" class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">Nom de l'Agent IA *</label>
            <input type="text" name="name" required placeholder="Ex. NexusAgent" class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white text-sm focus:outline-none focus:border-radar-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">URL du site officiel *</label>
            <input type="url" name="url" required placeholder="https://..." class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white text-sm focus:outline-none focus:border-radar-500" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">Catégorie principale *</label>
            <select name="category" class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white text-sm focus:outline-none focus:border-radar-500">
              <option>Code & Dev</option>
              <option>Support Client</option>
              <option>Prospection B2B</option>
              <option>Productivité & Assistant</option>
              <option>Comptabilité & Finance</option>
              <option>Conformité & Juridique</option>
              <option>Marketing & Contenu</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">Votre Email de contact *</label>
            <input type="email" name="email" required placeholder="fondateur@votre-saas.com" class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white text-sm focus:outline-none focus:border-radar-500" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-2">Description en 1 ou 2 phrases *</label>
          <textarea name="description" rows="3" required placeholder="Que fait votre agent de manière autonome ?" class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white text-sm focus:outline-none focus:border-radar-500"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-2">Option de révision</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="flex items-center gap-3 p-4 rounded-xl bg-dark-950 border border-dark-700 cursor-pointer hover:border-slate-500 transition">
              <input type="radio" name="plan" value="free" checked class="text-radar-500 focus:ring-radar-500" />
              <div>
                <span class="block text-xs font-bold text-white">Standard (Gratuit)</span>
                <span class="block text-[11px] text-slate-400">Délai normal de traitement</span>
              </div>
            </label>
            <label class="flex items-center gap-3 p-4 rounded-xl bg-dark-950 border border-radar-500/40 cursor-pointer hover:border-radar-500 transition">
              <input type="radio" name="plan" value="fasttrack" class="text-radar-500 focus:ring-radar-500" />
              <div>
                <span class="block text-xs font-bold text-radar-400">Fast-Track (49 €)</span>
                <span class="block text-[11px] text-slate-300">En ligne sous 24h + En vedette</span>
              </div>
            </label>
          </div>
        </div>

        <button
          type="submit"
          class="w-full py-4 rounded-xl bg-radar-500 hover:bg-radar-400 text-black font-bold text-sm transition-all shadow-lg shadow-radar-500/20"
        >
          Envoyer la demande d'audit
        </button>
      </form>
    </div>
  </div>
</Layout>
