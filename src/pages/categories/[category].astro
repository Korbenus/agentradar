---
import CategoryView from '../../components/CategoryView.astro';

export async function getStaticPaths() {
  const slugs = [
    'code-dev',
    'support-client',
    'prospection-b2b',
    'productivite-assistant',
    'comptabilite-finance',
    'conformite-juridique',
    'marketing-contenu'
  ];

  return slugs.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
---

<CategoryView category={category!} lang="en" />
