---
import CategoryView from '../../../components/CategoryView.astro';
import { languages, type SupportedLang, defaultLang } from '../../../i18n/translations';

export async function getStaticPaths() {
  const langs = Object.keys(languages).filter((l) => l !== defaultLang) as SupportedLang[];
  const slugs = [
    'code-dev',
    'support-client',
    'prospection-b2b',
    'productivite-assistant',
    'productivité-assistant',
    'comptabilite-finance',
    'comptabilité-finance',
    'conformite-juridique',
    'conformité-juridique',
    'marketing-contenu'
  ];

  return langs.flatMap((lang) =>
    slugs.map((category) => ({
      params: { lang, category },
    }))
  );
}

const { lang, category } = Astro.params;
---

<CategoryView category={category!} lang={lang as SupportedLang} />
