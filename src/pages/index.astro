---
import Layout from '../layouts/Layout.astro';
import AgentCard from '../components/AgentCard.astro';
import { getCollection } from 'astro:content';

const allAgents = await getCollection('agents');

// Sort by date added desc
const sortedAgents = allAgents.sort((a, b) => 
  new Date(b.data.dateAdded).getTime() - new Date(a.data.dateAdded).getTime()
);

const featuredAgents = sortedAgents.filter(a => a.data.featured);
const categories = [
  'Tous',
  'Code & Dev',
  'Support Client',
  'Prospection B2B',
  'Productivité & Assistant',
  'Conformité & Juridique',
  'Comptabilité & Finance',
];
---

<Layout>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Live Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-radar-500/10 border border-radar-500/30 text-radar-400 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-radar-400 animate-pulse"></span>
        <span>Observatoire 2026 • Veille Autonome Active</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
        Trouvez les meilleurs <span class="bg-gradient-to-r from-emerald-400 to-radar-400 bg-clip-text text-transparent">Agents IA Autonomes</span> pour votre entreprise
      </h1>

      <p class="mt-6 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Fini les simples chatbots. Comparez les agents capables de résoudre des tâches complexes de bout en bout : prospection, support client, code, finance et conformité EU AI Act.
      </p>

      <!-- Search & quick filters -->
      <div class="mt-8 max-w-xl mx-auto">
        <div class="relative">
          <input
            type="text"
            id="searchInput"
            placeholder="Rechercher un agent, un cas d'usage, un mot-clé..."
            class="w-full px-5 py-3.5 pl-12 rounded-xl bg-dark-900 border border-slate-700/80 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-radar-500 focus:ring-2 focus:ring-radar-500/20 transition-all shadow-lg"
          />
          <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Explore Section -->
  <section id="explore" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <!-- Categories Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 scrollbar-none">
      {categories.map((cat, idx) => (
        <button
          class={`filter-btn whitespace-nowrap text-xs sm:text-sm font-medium px-4 py-2 rounded-xl transition-all cursor-pointer ${
            idx === 0
              ? 'active bg-radar-500 text-black font-semibold shadow-md shadow-radar-500/20'
              : 'bg-dark-900 border border-dark-800 text-slate-300 hover:text-white hover:border-slate-700'
          }`}
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Featured Section (shown if "Tous" active) -->
    <div id="featuredContainer" class="mb-12">
      <div class="flex items-center gap-2 mb-6">
        <span class="text-radar-400 font-bold text-sm">★ SÉLECTION DE LA RÉDACTION</span>
        <div class="flex-grow h-[1px] bg-dark-800"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredAgents.map((agent) => (
          <AgentCard agent={agent} />
        ))}
      </div>
    </div>

    <!-- All Agents Grid -->
    <div>
      <div class="flex items-center justify-between gap-2 mb-6">
        <div class="flex items-center gap-2">
          <h2 id="gridTitle" class="text-lg font-bold text-white">Tous les Agents Référencés</h2>
          <span id="agentCount" class="text-xs text-slate-400 bg-dark-900 px-2.5 py-1 rounded-full border border-dark-800">
            {sortedAgents.length} disponibles
          </span>
        </div>
        <div class="flex-grow h-[1px] bg-dark-800 ml-4 hidden sm:block"></div>
      </div>

      <div id="agentsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedAgents.map((agent) => (
          <div class="agent-item" data-category={agent.data.category} data-name={agent.data.name.toLowerCase()} data-tagline={agent.data.tagline.toLowerCase()}>
            <AgentCard agent={agent} />
          </div>
        ))}
      </div>

      <!-- No result state -->
      <div id="noResults" class="hidden text-center py-16 bg-dark-900/40 rounded-2xl border border-dark-800">
        <p class="text-slate-400 text-sm">Aucun agent ne correspond à votre recherche.</p>
        <button id="resetSearch" class="mt-4 text-xs font-semibold text-radar-400 hover:underline">
          Réinitialiser la recherche
        </button>
      </div>
    </div>

    <!-- Monetization / Value Props Banner -->
    <div class="mt-20 p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-dark-900 via-dark-900/90 to-emerald-950/40 border border-dark-800 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <span class="text-xs font-bold text-radar-400 uppercase tracking-wider">Pour les créateurs de SaaS & IA</span>
        <h3 class="text-xl sm:text-2xl font-bold text-white">Vous éditez un Agent IA autonome ?</h3>
        <p class="text-sm text-slate-400 max-w-xl">
          Faites découvrir votre solution à plus de 15 000 professionnels, décideurs et fondateurs qui cherchent à automatiser leurs opérations.
        </p>
      </div>
      <a
        href="/submit"
        class="whitespace-nowrap px-6 py-3 rounded-xl bg-radar-500 hover:bg-radar-400 text-black font-bold text-sm transition-all shadow-lg shadow-radar-500/20"
      >
        Référencer mon agent →
      </a>
    </div>
  </section>
</Layout>

<script>
  // Instant client-side search & filter logic
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const filterButtons = document.querySelectorAll('.filter-btn');
  const agentItems = document.querySelectorAll('.agent-item');
  const featuredContainer = document.getElementById('featuredContainer');
  const noResults = document.getElementById('noResults');
  const agentCount = document.getElementById('agentCount');
  const resetSearch = document.getElementById('resetSearch');

  let activeCategory = 'Tous';
  let searchTerm = '';

  function updateList() {
    let visibleCount = 0;

    agentItems.forEach((el) => {
      const item = el as HTMLElement;
      const cat = item.dataset.category || '';
      const name = item.dataset.name || '';
      const tagline = item.dataset.tagline || '';

      const matchCategory = activeCategory === 'Tous' || cat === activeCategory;
      const matchSearch = searchTerm === '' || name.includes(searchTerm) || tagline.includes(searchTerm);

      if (matchCategory && matchSearch) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // Hide featured section when searching or filtering by specific category
    if (featuredContainer) {
      if (activeCategory !== 'Tous' || searchTerm !== '') {
        featuredContainer.style.display = 'none';
      } else {
        featuredContainer.style.display = 'block';
      }
    }

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    if (agentCount) {
      agentCount.textContent = `${visibleCount} disponible${visibleCount > 1 ? 's' : ''}`;
    }
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('active', 'bg-radar-500', 'text-black', 'font-semibold', 'shadow-md', 'shadow-radar-500/20');
        b.classList.add('bg-dark-900', 'border', 'border-dark-800', 'text-slate-300');
      });

      btn.classList.add('active', 'bg-radar-500', 'text-black', 'font-semibold', 'shadow-md', 'shadow-radar-500/20');
      btn.classList.remove('bg-dark-900', 'border', 'border-dark-800', 'text-slate-300');

      activeCategory = btn.getAttribute('data-category') || 'Tous';
      updateList();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
      updateList();
    });
  }

  if (resetSearch && searchInput) {
    resetSearch.addEventListener('click', () => {
      searchInput.value = '';
      searchTerm = '';
      activeCategory = 'Tous';
      filterButtons[0]?.dispatchEvent(new Event('click'));
      updateList();
    });
  }
</script>
