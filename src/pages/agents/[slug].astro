---
import AgentView from '../../components/AgentView.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const agents = await getCollection('agents');
  return agents.map((agent) => ({
    params: { slug: agent.id.replace(/\.md$/, '') },
    props: { agent, allAgents: agents },
  }));
}

interface Props {
  agent: CollectionEntry<'agents'>;
  allAgents: CollectionEntry<'agents'>[];
}

const { agent, allAgents } = Astro.props;
---

<AgentView agent={agent} allAgents={allAgents} lang="en" />
