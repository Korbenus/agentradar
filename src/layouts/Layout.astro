---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, type SupportedLang, languages } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: SupportedLang;
}

const {
  title = "AgentRadar | Compare the Best Autonomous AI Agents (2026)",
  description = "Discover, compare and select the best autonomous AI agents for your business. B2B sales outreach, customer support, coding, accounting, and EU AI Act compliance.",
  ogImage = "/og-image.png",
  lang = defaultLang
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Helper for hreflang links
function getCleanPath(): string {
  let p = Astro.url.pathname;
  for (const l of Object.keys(languages)) {
    if (p === `/${l}` || p === `/${l}/`) return '/';
    if (p.startsWith(`/${l}/`)) return p.slice(l.length + 1);
  }
  return p;
}

const cleanPath = getCleanPath();
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Multilingual hreflang alternate links for SEO -->
    <link rel="alternate" hreflang="x-default" href={new URL(cleanPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(cleanPath, Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL(`/fr${cleanPath === '/' ? '' : cleanPath}`, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(`/es${cleanPath === '/' ? '' : cleanPath}`, Astro.site)} />
    <link rel="alternate" hreflang="de" href={new URL(`/de${cleanPath === '/' ? '' : cleanPath}`, Astro.site)} />
    <link rel="alternate" hreflang="it" href={new URL(`/it${cleanPath === '/' ? '' : cleanPath}`, Astro.site)} />
    <link rel="alternate" hreflang="ja" href={new URL(`/ja${cleanPath === '/' ? '' : cleanPath}`, Astro.site)} />

    <!-- RSS feed auto-discovery -->
    <link rel="alternate" type="application/rss+xml" title="AgentRadar RSS Feed" href="/rss.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "AgentRadar",
      "url": "https://agentradar.pages.dev",
      "description": description,
      "inLanguage": lang
    })} />
  </head>
  <body class="bg-dark-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased selection:bg-radar-500 selection:text-black">
    <!-- Background subtle gradient grid -->
    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden opacity-30">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-gradient-to-b from-radar-500/20 via-emerald-600/10 to-transparent blur-3xl rounded-full"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    </div>

    <Header lang={lang} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }
  code, pre {
    font-family: 'JetBrains Mono', monospace;
  }
  /* Hide scrollbar on all browsers */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
