---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, type SupportedLang, languages } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: SupportedLang;
}

const {
  title = "AgentRadar | Independent directory of AI tools",
  description = "Explore documentary profiles of business AI tools, with official sources and practical selection criteria.",
  ogImage,
  lang = defaultLang
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Helper for hreflang links
function getCleanPath(): string {
  let p = Astro.url.pathname;
  for (const l of Object.keys(languages)) {
    if (p === `/${l}` || p === `/${l}/`) return '/';
    if (p.startsWith(`/${l}/`)) return p.slice(l.length + 1);
  }
  return p;
}

const cleanPath = getCleanPath();
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}

    <!-- Twitter -->
    <meta property="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />}

    <!-- Multilingual hreflang alternate links for SEO -->
    <link rel="alternate" hreflang="x-default" href={new URL(cleanPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(cleanPath, Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL(`/fr${cleanPath === '/' ? '' : cleanPath}`, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(`/es${cleanPath === '/' ? '' : cleanPath}`, Astro.site)} />
    <link rel="alternate" hreflang="de" href={new URL(`/de${cleanPath === '/' ? '' : cleanPath}`, Astro.site)} />
    <link rel="alternate" hreflang="it" href={new URL(`/it${cleanPath === '/' ? '' : cleanPath}`, Astro.site)} />
    <link rel="alternate" hreflang="ja" href={new URL(`/ja${cleanPath === '/' ? '' : cleanPath}`, Astro.site)} />

    <!-- RSS feed auto-discovery -->
    <link rel="alternate" type="application/rss+xml" title="AgentRadar RSS Feed" href="/rss.xml" />

    <!-- Theme initialization (Dark / Light mode) -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('ar_theme');
          if (saved === 'light') {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "AgentRadar",
      "url": "https://agentradar.pages.dev",
      "description": description,
      "inLanguage": lang
    })} />
  </head>
  <body class="bg-dark-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased selection:bg-radar-500 selection:text-black">
    <!-- Background subtle gradient grid -->
    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden opacity-30">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-gradient-to-b from-radar-500/20 via-emerald-600/10 to-transparent blur-3xl rounded-full"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    </div>

    <Header lang={lang} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    letter-spacing: -0.01em;
  }
  code, pre {
    font-family: 'JetBrains Mono', monospace;
  }
  /* Hide scrollbar on all browsers */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* ==========================================================================
     HUMAN-CENTRIC EDITORIAL TYPOGRAPHY (.prose & .prose-editorial)
     Inspired by Wirecutter, G2, and Stripe Docs
     ========================================================================== */
  .prose,
  .prose-editorial {
    color: #e2e8f0;
    font-size: 1.0625rem; /* 17px comfortable reading size */
    line-height: 1.8;
  }

  .prose h2,
  .prose-editorial h2 {
    color: #ffffff;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(59, 79, 115, 0.5);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .prose h2:first-child,
  .prose-editorial h2:first-child {
    margin-top: 0.25rem;
  }

  .prose h3,
  .prose-editorial h3 {
    color: #f8fafc;
    font-size: 1.2rem;
    line-height: 1.4;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prose p,
  .prose-editorial p {
    margin-top: 0;
    margin-bottom: 1.25rem;
    color: #cbd5e1;
  }

  .prose strong,
  .prose-editorial strong {
    color: #ffffff;
    font-weight: 700;
  }

  .prose ul,
  .prose-editorial ul {
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
    padding-left: 0;
    list-style: none;
  }

  .prose ul li,
  .prose-editorial ul li {
    position: relative;
    padding-left: 1.65rem;
    margin-bottom: 0.65rem;
    color: #e2e8f0;
    line-height: 1.7;
  }

  .prose ul li::before,
  .prose-editorial ul li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0.05rem;
    color: #14b8a6;
    font-weight: 800;
    font-size: 0.95rem;
  }

  .prose ol,
  .prose-editorial ol {
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    list-style: decimal;
    color: #e2e8f0;
  }

  .prose ol li,
  .prose-editorial ol li {
    margin-bottom: 0.65rem;
    padding-left: 0.35rem;
    line-height: 1.7;
  }

  .prose ol li::marker,
  .prose-editorial ol li::marker {
    color: #2dd4bf;
    font-weight: 700;
  }

  .prose a,
  .prose-editorial a {
    color: #2dd4bf;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .prose a:hover,
  .prose-editorial a:hover {
    color: #5eead4;
  }

  /* ==========================================================================
     DAYLIGHT / LIGHT MODE THEME (html.light)
     High-contrast paper readability for daytime users
     ========================================================================== */
  html.light body {
    background-color: #f8fafc !important;
    color: #0f172a !important;
  }
  .site-header {
    background-color: rgba(2, 6, 23, 0.95);
  }
  html.light .site-header {
    background-color: rgba(255, 255, 255, 0.95) !important;
    border-color: #cbd5e1 !important;
  }
  html.light [class*="bg-dark-950"]:not(.active) {
    background-color: #f1f5f9 !important;
  }
  html.light [class*="bg-dark-900"]:not(.active) {
    background-color: #ffffff !important;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06) !important;
  }
  html.light [class*="bg-dark-850"]:not(.active),
  html.light [class*="bg-dark-800"]:not(.active),
  html.light [class*="bg-dark-750"]:not(.active),
  html.light [class*="bg-slate-800"]:not(.active),
  html.light [class*="bg-slate-900"]:not(.active) {
    background-color: #f1f5f9 !important;
  }
  html.light a[class*="bg-dark-800"]:hover,
  html.light button[class*="bg-dark-800"]:not(.active):hover,
  html.light a[class*="bg-dark-900"]:hover,
  html.light button[class*="bg-dark-900"]:not(.active):hover {
    background-color: #e2e8f0 !important;
  }
  .filter-btn.active,
  .pricing-btn.active,
  html.light .filter-btn.active,
  html.light .pricing-btn.active {
    background-color: #10b981 !important;
    color: #022c22 !important;
    border-color: #059669 !important;
    font-weight: 800 !important;
  }
  html.light .hover\:text-white:hover {
    color: #0f172a !important;
  }
  html.light [class*="bg-emerald-500/10"],
  html.light [class*="bg-emerald-500/15"],
  html.light [class*="bg-emerald-950"] {
    background-color: #ecfdf5 !important;
    border-color: #6ee7b7 !important;
  }
  html.light [class*="bg-rose-950"] {
    background-color: #fff1f2 !important;
    border-color: #fda4af !important;
  }
  html.light [class*="bg-blue-500/15"] {
    background-color: #eff6ff !important;
    border-color: #93c5fd !important;
    color: #1d4ed8 !important;
  }
  html.light [class*="bg-amber-400/15"],
  html.light [class*="bg-amber-500/15"] {
    background-color: #fffbeb !important;
    border-color: #fcd34d !important;
    color: #b45309 !important;
  }
  html.light [class*="border-dark-"] {
    border-color: #cbd5e1 !important;
  }
  html.light .text-white {
    color: #0f172a !important;
  }
  html.light .text-slate-100,
  html.light .text-slate-200 {
    color: #0f172a !important;
  }
  html.light .text-slate-300 {
    color: #1e293b !important;
  }
  html.light .text-slate-400,
  html.light .text-slate-500 {
    color: #475569 !important;
  }
  html.light .text-radar-400,
  html.light .text-radar-300 {
    color: #0f766e !important;
  }
  html.light .text-emerald-400,
  html.light .text-emerald-300 {
    color: #047857 !important;
  }
  html.light .text-rose-400,
  html.light .text-rose-300 {
    color: #be123c !important;
  }
  html.light .text-amber-300,
  html.light .text-amber-400 {
    color: #b45309 !important;
  }
  html.light .prose,
  html.light .prose-editorial {
    color: #1e293b !important;
  }
  html.light .prose h2,
  html.light .prose-editorial h2,
  html.light .prose h3,
  html.light .prose-editorial h3,
  html.light .prose strong,
  html.light .prose-editorial strong {
    color: #0f172a !important;
  }
  html.light .prose p,
  html.light .prose-editorial p,
  html.light .prose ul li,
  html.light .prose-editorial ul li,
  html.light .prose ol li,
  html.light .prose-editorial ol li {
    color: #334155 !important;
  }
</style>
