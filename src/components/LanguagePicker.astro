---
import { languages, type SupportedLang, defaultLang } from '../i18n/translations';

interface Props {
  currentLang?: SupportedLang;
}

const { currentLang = defaultLang } = Astro.props;
const pathname = Astro.url.pathname;

function getTargetUrl(targetLang: SupportedLang): string {
  let cleanPath = pathname;

  // Normalize trailing slash (keep only root '/')
  if (cleanPath.length > 1 && cleanPath.endsWith('/')) {
    cleanPath = cleanPath.slice(0, -1);
  }

  // Strip existing lang prefix
  for (const l of Object.keys(languages)) {
    if (cleanPath === `/${l}`) {
      cleanPath = '/';
      break;
    }
    if (cleanPath.startsWith(`/${l}/`)) {
      cleanPath = cleanPath.slice(l.length + 1);
      break;
    }
  }

  // Ensure cleanPath starts with '/'
  if (!cleanPath.startsWith('/')) {
    cleanPath = '/' + cleanPath;
  }

  if (targetLang === defaultLang) {
    return cleanPath;
  } else {
    return cleanPath === '/' ? `/${targetLang}` : `/${targetLang}${cleanPath}`;
  }
}
---

<div class="relative inline-block text-left" id="lang-picker-dropdown">
  <button
    type="button"
    id="langPickerToggle"
    class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-dark-900 border border-dark-800 text-xs font-semibold text-slate-300 hover:text-white hover:border-slate-700 transition cursor-pointer"
    aria-label="Change language"
    aria-haspopup="true"
  >
    <span>{languages[currentLang]?.flag}</span>
    <span class="uppercase font-mono">{languages[currentLang]?.label}</span>
    <svg class="w-3 h-3 text-slate-400 transition-transform" id="langChevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id="langPickerMenu"
    class="absolute right-0 mt-1 w-36 rounded-xl bg-dark-900 border border-dark-800 shadow-2xl py-1 hidden z-50 backdrop-blur-lg"
  >
    {(Object.entries(languages) as [SupportedLang, { name: string; flag: string; label: string }][]).map(([key, info]) => {
      const active = key === currentLang;
      return (
        <a
          href={getTargetUrl(key)}
          class={`flex items-center justify-between px-3 py-2 text-xs transition ${
            active 
              ? 'bg-radar-500/10 text-radar-400 font-bold' 
              : 'text-slate-300 hover:bg-dark-800 hover:text-white'
          }`}
        >
          <span class="flex items-center gap-2">
            <span>{info.flag}</span>
            <span>{info.name}</span>
          </span>
          {active && <span class="text-[10px] text-radar-400 font-mono">✓</span>}
        </a>
      );
    })}
  </div>
</div>

<script is:inline>
  (function() {
    const container = document.getElementById('lang-picker-dropdown');
    const toggle = document.getElementById('langPickerToggle');
    const menu = document.getElementById('langPickerMenu');
    const chevron = document.getElementById('langChevron');

    if (!container || !toggle || !menu) return;

    function openMenu() {
      menu.classList.remove('hidden');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
    }

    function closeMenu() {
      menu.classList.add('hidden');
      if (chevron) chevron.style.transform = 'rotate(0deg)';
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      if (menu.classList.contains('hidden')) {
        openMenu();
      } else {
        closeMenu();
      }
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target)) {
        closeMenu();
      }
    });

    // Also support hover for desktop mice
    container.addEventListener('mouseenter', openMenu);
    container.addEventListener('mouseleave', closeMenu);
  })();
</script>
