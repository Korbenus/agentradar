---
import { languages, type SupportedLang, defaultLang } from '../i18n/translations';

interface Props {
  currentLang?: SupportedLang;
}

const { currentLang = defaultLang } = Astro.props;
const pathname = Astro.url.pathname;

function getTargetUrl(targetLang: SupportedLang): string {
  // Strip existing lang prefix if present
  let cleanPath = pathname;
  const langPrefixes = Object.keys(languages);
  for (const l of langPrefixes) {
    if (cleanPath === `/${l}` || cleanPath === `/${l}/`) {
      cleanPath = '/';
      break;
    } else if (cleanPath.startsWith(`/${l}/`)) {
      cleanPath = cleanPath.slice(l.length + 1);
      break;
    }
  }

  if (targetLang === defaultLang) {
    return cleanPath === '' ? '/' : cleanPath;
  } else {
    return cleanPath === '/' ? `/${targetLang}` : `/${targetLang}${cleanPath}`;
  }
}
---

<div class="relative group" id="lang-picker-dropdown">
  <button
    type="button"
    class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-dark-900 border border-dark-800 text-xs font-semibold text-slate-300 hover:text-white hover:border-slate-700 transition"
    aria-label="Change language"
  >
    <span>{languages[currentLang]?.flag}</span>
    <span class="uppercase font-mono">{languages[currentLang]?.label}</span>
    <svg class="w-3 h-3 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div class="absolute right-0 mt-1 w-36 rounded-xl bg-dark-900 border border-dark-800 shadow-2xl py-1 hidden group-hover:block hover:block z-50 backdrop-blur-lg">
    {(Object.entries(languages) as [SupportedLang, { name: string; flag: string; label: string }][]).map(([key, info]) => {
      const active = key === currentLang;
      return (
        <a
          href={getTargetUrl(key)}
          class={`flex items-center justify-between px-3 py-2 text-xs transition ${
            active 
              ? 'bg-radar-500/10 text-radar-400 font-bold' 
              : 'text-slate-300 hover:bg-dark-800 hover:text-white'
          }`}
        >
          <span class="flex items-center gap-2">
            <span>{info.flag}</span>
            <span>{info.name}</span>
          </span>
          {active && <span class="text-[10px] text-radar-400 font-mono">✓</span>}
        </a>
      );
    })}
  </div>
</div>
