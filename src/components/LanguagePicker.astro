---
import { languages, type SupportedLang, defaultLang } from '../i18n/translations';
import FlagIcon from './FlagIcon.astro';

interface Props {
  currentLang?: SupportedLang;
}

const { currentLang = defaultLang } = Astro.props;
const pathname = Astro.url.pathname;

function getTargetUrl(targetLang: SupportedLang): string {
  let cleanPath = pathname;

  // Normalize trailing slash (keep only root '/')
  if (cleanPath.length > 1 && cleanPath.endsWith('/')) {
    cleanPath = cleanPath.slice(0, -1);
  }

  // Strip existing lang prefix
  for (const l of Object.keys(languages)) {
    if (cleanPath === `/${l}`) {
      cleanPath = '/';
      break;
    }
    if (cleanPath.startsWith(`/${l}/`)) {
      cleanPath = cleanPath.slice(l.length + 1);
      break;
    }
  }

  // Ensure cleanPath starts with '/'
  if (!cleanPath.startsWith('/')) {
    cleanPath = '/' + cleanPath;
  }

  if (targetLang === defaultLang) {
    return cleanPath;
  } else {
    return cleanPath === '/' ? `/${targetLang}` : `/${targetLang}${cleanPath}`;
  }
}
---

<div class="relative inline-block text-left" id="lang-picker-dropdown">
  <button
    type="button"
    id="langPickerToggle"
    class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-dark-900/90 hover:bg-dark-850 border border-dark-700/80 hover:border-slate-600 text-xs font-semibold text-slate-200 hover:text-white transition-all shadow-sm cursor-pointer select-none"
    aria-label="Change language"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <FlagIcon lang={currentLang} class="w-4 h-4 rounded-full overflow-hidden shadow ring-1 ring-white/25 shrink-0" />
    <span class="uppercase font-mono tracking-wider text-[11px] font-bold text-slate-200">{languages[currentLang]?.label}</span>
    <svg class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200" id="langChevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu Wrapper (starts directly below button, pt-1.5 eliminates any gap) -->
  <div
    id="langPickerMenu"
    class="absolute right-0 top-full pt-1.5 w-48 hidden z-50"
  >
    <!-- Styled Card -->
    <div class="rounded-2xl bg-dark-900/98 border border-dark-700 shadow-2xl py-2 backdrop-blur-xl">
      <div class="px-3 py-1 text-[10px] font-bold tracking-wider uppercase text-slate-500 border-b border-dark-800/80 mb-1 flex items-center justify-between">
        <span>Select Language</span>
        <span class="text-[9px] text-slate-600 font-mono">6 locales</span>
      </div>
      {(Object.entries(languages) as [SupportedLang, { name: string; flag: string; label: string }][]).map(([key, info]) => {
        const active = key === currentLang;
        return (
          <a
            href={getTargetUrl(key)}
            class={`flex items-center justify-between px-3.5 py-2 text-xs rounded-xl mx-1 transition-all ${
              active 
                ? 'bg-radar-500/15 text-radar-400 font-bold border border-radar-500/30' 
                : 'text-slate-300 hover:bg-dark-800 hover:text-white hover:translate-x-0.5'
            }`}
          >
            <span class="flex items-center gap-2.5">
              <FlagIcon lang={key} class="w-4 h-4 rounded-full overflow-hidden shadow ring-1 ring-white/20 shrink-0" />
              <span class="font-medium">{info.name}</span>
            </span>
            {active && <span class="text-[11px] text-radar-400 font-bold font-mono">✓</span>}
          </a>
        );
      })}
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const container = document.getElementById('lang-picker-dropdown');
    const toggle = document.getElementById('langPickerToggle');
    const menu = document.getElementById('langPickerMenu');
    const chevron = document.getElementById('langChevron');

    if (!container || !toggle || !menu) return;

    let isOpen = false;
    let leaveTimer = null;

    function openMenu() {
      if (leaveTimer) {
        clearTimeout(leaveTimer);
        leaveTimer = null;
      }
      menu.classList.remove('hidden');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
      toggle.setAttribute('aria-expanded', 'true');
      isOpen = true;
    }

    function closeMenu() {
      if (leaveTimer) {
        clearTimeout(leaveTimer);
        leaveTimer = null;
      }
      menu.classList.add('hidden');
      if (chevron) chevron.style.transform = 'rotate(0deg)';
      toggle.setAttribute('aria-expanded', 'false');
      isOpen = false;
    }

    // Toggle on button click (locks open until clicked again, clicked outside, or item selected)
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close when clicking anywhere outside
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target)) {
        closeMenu();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    // Hover with 300ms grace period so moving cursor across edges NEVER closes prematurely
    container.addEventListener('mouseenter', () => {
      openMenu();
    });

    container.addEventListener('mouseleave', () => {
      // 300ms grace timeout: if the user quickly moves cursor back, it remains open
      leaveTimer = setTimeout(() => {
        closeMenu();
      }, 300);
    });
  })();
</script>
