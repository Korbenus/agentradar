---
import { editorialCopy } from '../lib/editorial';
import { useTranslations, type SupportedLang, defaultLang } from '../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const copy = editorialCopy(lang);
const year = new Date().getFullYear();

function localizedHref(path: string): string {
  if (lang === defaultLang) return path;
  if (path === '/') return `/${lang}`;
  return `/${lang}${path}`;
}
---

<footer class="border-t border-dark-800 bg-dark-900/60 mt-24 py-12 text-sm text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: About -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-radar-500"></div>
          <span class="font-bold text-white text-base">AgentRadar</span>
        </div>
        <p class="text-slate-400 text-xs sm:text-sm max-w-md leading-relaxed">
          {t('footer.about')}
        </p>
        <div class="text-xs text-slate-500">
          {t('footer.transparency')}
        </div>
      </div>

      <!-- Col 2: Categories -->
      <div>
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-3">{t('footer.keyCategories')}</h4>
        <ul class="space-y-2 text-xs">
          <li><a href={localizedHref('/categories/support-client')} class="hover:text-radar-400 transition">{t('cat.supportClient')}</a></li>
          <li><a href={localizedHref('/categories/prospection-b2b')} class="hover:text-radar-400 transition">{t('cat.prospectionB2B')}</a></li>
          <li><a href={localizedHref('/categories/code-dev')} class="hover:text-radar-400 transition">{t('cat.codeDev')}</a></li>
          <li><a href={localizedHref('/categories/productivite-assistant')} class="hover:text-radar-400 transition">{t('cat.productiviteAssistant')}</a></li>
          <li><a href={localizedHref('/categories/comptabilite-finance')} class="hover:text-radar-400 transition">{t('cat.comptabiliteFinance')}</a></li>
          <li><a href={localizedHref('/categories/conformite-juridique')} class="hover:text-radar-400 transition">{t('cat.conformiteJuridique')}</a></li>
          <li><a href={localizedHref('/categories/marketing-contenu')} class="hover:text-radar-400 transition">{t('cat.marketingContenu')}</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & Links -->
      <div>
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-3">{t('footer.platform')}</h4>
        <ul class="space-y-2 text-xs">
          <li><a href={localizedHref('/about')} class="hover:text-radar-400 transition">{copy.about}</a></li>
          <li><a href={localizedHref('/methodology')} class="hover:text-radar-400 transition">{copy.methodology}</a></li>
          <li><a href={localizedHref('/compare')} class="hover:text-radar-400 transition">{t('nav.compare')}</a></li>
          <li><a href={localizedHref('/privacy')} class="hover:text-radar-400 transition">{t('footer.privacy')}</a></li>
          <li><a href={localizedHref('/terms')} class="hover:text-radar-400 transition">{t('footer.terms')}</a></li>
          <li><a href="/rss.xml" class="hover:text-radar-400 transition">RSS Feed</a></li>
          <li><span class="text-emerald-400/90 font-medium">{t('footer.monitoringActive')}</span></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-dark-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {year} AgentRadar. {t('footer.rights')}</p>
      <p class="flex items-center gap-1">
        {t('footer.network')}
      </p>
    </div>
  </div>
</footer>
