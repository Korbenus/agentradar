---
import Layout from '../layouts/Layout.astro';
import AgentCard from './AgentCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type SupportedLang, defaultLang } from '../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const allAgents = await getCollection('agents');

// Sort by date added desc
const sortedAgents = allAgents.sort((a, b) => 
  new Date(b.data.dateAdded).getTime() - new Date(a.data.dateAdded).getTime()
);

const featuredAgents = sortedAgents.filter(a => a.data.featured);

const categories = [
  { key: 'filter.all', label: t('filter.all'), val: 'ALL' },
  { key: 'cat.codeDev', label: t('cat.codeDev'), val: 'Code & Dev' },
  { key: 'cat.supportClient', label: t('cat.supportClient'), val: 'Support Client' },
  { key: 'cat.prospectionB2B', label: t('cat.prospectionB2B'), val: 'Prospection B2B' },
  { key: 'cat.productiviteAssistant', label: t('cat.productiviteAssistant'), val: 'Productivité & Assistant' },
  { key: 'cat.conformiteJuridique', label: t('cat.conformiteJuridique'), val: 'Conformité & Juridique' },
  { key: 'cat.comptabiliteFinance', label: t('cat.comptabiliteFinance'), val: 'Comptabilité & Finance' },
  { key: 'cat.marketingContenu', label: t('cat.marketingContenu'), val: 'Marketing & Contenu' },
];

const pricingFilters = [
  { label: t('filter.pricingAll'), val: 'ALL' },
  { label: t('filter.free'), val: 'FREE' },
  { label: t('filter.paid'), val: 'PAID' },
];

function localizedHref(path: string): string {
  if (lang === defaultLang) return path;
  if (path === '/') return `/${lang}`;
  return `/${lang}${path}`;
}
---

<Layout lang={lang}>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Live Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-radar-500/10 border border-radar-500/30 text-radar-400 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-radar-400 animate-pulse"></span>
        <span>{t('hero.badge')}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
        {t('hero.title')}{' '}
        <span class="bg-gradient-to-r from-emerald-400 to-radar-400 bg-clip-text text-transparent">
          {t('hero.titleHighlight')}
        </span>{' '}
        {t('hero.titleEnd')}
      </h1>

      <p class="mt-6 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        {t('hero.subtitle')}
      </p>

      <!-- Search & quick filters -->
      <div class="mt-8 max-w-xl mx-auto">
        <div class="relative group">
          <input
            type="text"
            id="searchInput"
            placeholder={t('hero.searchPlaceholder')}
            class="w-full px-5 py-3.5 pl-12 pr-20 rounded-xl bg-dark-900 border border-slate-700/80 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-radar-500 focus:ring-2 focus:ring-radar-500/20 transition-all shadow-lg"
          />
          <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <kbd class="hidden sm:inline-block absolute right-3 top-1/2 -translate-y-1/2 px-2 py-0.5 text-[10px] font-mono rounded bg-dark-800 border border-dark-700 text-slate-400">
            {t('search.cmdShortcut')}
          </kbd>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Explore Section -->
  <section id="explore" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <!-- Categories Filter Tabs (Primary) -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 mb-4 scrollbar-none">
      {categories.map((cat, idx) => (
        <button
          class={`filter-btn whitespace-nowrap text-xs sm:text-sm font-medium px-4 py-2 rounded-xl transition-all cursor-pointer ${
            idx === 0
              ? 'active bg-radar-500 text-black font-semibold shadow-md shadow-radar-500/20'
              : 'bg-dark-900 border border-dark-800 text-slate-300 hover:text-white hover:border-slate-700'
          }`}
          data-category={cat.val}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Secondary Faceted Filters: Budget & AI Act Badge -->
    <div class="flex flex-wrap items-center justify-between gap-3 p-3 rounded-2xl bg-dark-900/60 border border-dark-800/80 mb-8">
      <!-- Pricing Filter Pills -->
      <div class="flex items-center gap-1.5 overflow-x-auto">
        <span class="text-[11px] uppercase font-bold text-slate-500 mr-2 tracking-wider">Budget:</span>
        {pricingFilters.map((pf, idx) => (
          <button
            class={`pricing-btn text-xs font-medium px-3 py-1.5 rounded-lg transition cursor-pointer ${
              idx === 0 
                ? 'active bg-slate-800 text-white font-semibold' 
                : 'text-slate-400 hover:text-white hover:bg-dark-800'
            }`}
            data-pricing={pf.val}
          >
            {pf.label}
          </button>
        ))}
      </div>

      <!-- AI Act Checkbox Toggle -->
      <label class="inline-flex items-center gap-2 cursor-pointer select-none text-xs text-slate-300 hover:text-white transition">
        <input type="checkbox" id="aiActToggle" class="rounded bg-dark-950 border-slate-700 text-radar-500 focus:ring-radar-500/40 w-3.5 h-3.5" />
        <span>{t('filter.aiActOnly')}</span>
      </label>
    </div>

    <!-- Featured Section (shown if "ALL" active) -->
    <div id="featuredContainer" class="mb-12">
      <div class="flex items-center gap-2 mb-6">
        <span class="text-radar-400 font-bold text-sm">{t('section.editorialPick')}</span>
        <div class="flex-grow h-[1px] bg-dark-800"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredAgents.map((agent) => (
          <AgentCard agent={agent} lang={lang} />
        ))}
      </div>
    </div>

    <!-- All Agents Grid -->
    <div>
      <div class="flex items-center justify-between gap-2 mb-6">
        <div class="flex items-center gap-2">
          <h2 id="gridTitle" class="text-lg font-bold text-white">{t('section.allAgents')}</h2>
          <span id="agentCount" class="text-xs text-slate-400 bg-dark-900 px-2.5 py-1 rounded-full border border-dark-800">
            {sortedAgents.length} {t('section.available')}
          </span>
        </div>
        <div class="flex-grow h-[1px] bg-dark-800 ml-4 hidden sm:block"></div>
      </div>

      <div id="agentsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedAgents.map((agent) => (
          <div 
            class="agent-item" 
            data-category={agent.data.category} 
            data-name={agent.data.name.toLowerCase()} 
            data-tagline={agent.data.tagline.toLowerCase()}
            data-pricing-model={agent.data.pricingModel.toLowerCase()}
            data-ai-act={agent.data.aiActCompliant ? 'true' : 'false'}
          >
            <AgentCard agent={agent} lang={lang} />
          </div>
        ))}
      </div>

      <!-- No result state -->
      <div id="noResults" class="hidden text-center py-16 bg-dark-900/40 rounded-2xl border border-dark-800">
        <p class="text-slate-400 text-sm">{t('section.noResults')}</p>
        <button id="resetSearch" class="mt-4 text-xs font-semibold text-radar-400 hover:underline">
          {t('section.resetSearch')}
        </button>
      </div>
    </div>
  </section>
</Layout>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const filterButtons = document.querySelectorAll('.filter-btn');
  const pricingButtons = document.querySelectorAll('.pricing-btn');
  const aiActToggle = document.getElementById('aiActToggle') as HTMLInputElement | null;
  const agentItems = document.querySelectorAll('.agent-item');
  const featuredContainer = document.getElementById('featuredContainer');
  const noResults = document.getElementById('noResults');
  const agentCount = document.getElementById('agentCount');
  const resetSearch = document.getElementById('resetSearch');

  let activeCategory = 'ALL';
  let activePricing = 'ALL';
  let aiActOnly = false;
  let searchTerm = '';

  function updateList() {
    let visibleCount = 0;

    agentItems.forEach((el) => {
      const item = el as HTMLElement;
      const cat = item.dataset.category || '';
      const name = item.dataset.name || '';
      const tagline = item.dataset.tagline || '';
      const pricingModel = (item.dataset.pricingModel || '').toLowerCase();
      const isAiAct = item.dataset.aiAct === 'true';

      const matchCategory = activeCategory === 'ALL' || cat === activeCategory;
      const matchSearch = searchTerm === '' || name.includes(searchTerm) || tagline.includes(searchTerm);
      
      let matchPricing = true;
      if (activePricing === 'FREE') {
        matchPricing = pricingModel.includes('freemium') || pricingModel.includes('gratuit') || pricingModel.includes('open-source');
      } else if (activePricing === 'PAID') {
        matchPricing = pricingModel.includes('payant') || pricingModel.includes('sur devis');
      }

      const matchAiAct = !aiActOnly || isAiAct;

      if (matchCategory && matchSearch && matchPricing && matchAiAct) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    if (featuredContainer) {
      if (activeCategory !== 'ALL' || searchTerm !== '' || activePricing !== 'ALL' || aiActOnly) {
        featuredContainer.style.display = 'none';
      } else {
        featuredContainer.style.display = 'block';
      }
    }

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    if (agentCount) {
      agentCount.textContent = `${visibleCount}`;
    }
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('active', 'bg-radar-500', 'text-black', 'font-semibold', 'shadow-md', 'shadow-radar-500/20');
        b.classList.add('bg-dark-900', 'border', 'border-dark-800', 'text-slate-300');
      });

      btn.classList.add('active', 'bg-radar-500', 'text-black', 'font-semibold', 'shadow-md', 'shadow-radar-500/20');
      btn.classList.remove('bg-dark-900', 'border', 'border-dark-800', 'text-slate-300');

      activeCategory = btn.getAttribute('data-category') || 'ALL';
      updateList();
    });
  });

  pricingButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      pricingButtons.forEach((b) => {
        b.classList.remove('active', 'bg-slate-800', 'text-white', 'font-semibold');
        b.classList.add('text-slate-400');
      });

      btn.classList.add('active', 'bg-slate-800', 'text-white', 'font-semibold');
      btn.classList.remove('text-slate-400');

      activePricing = btn.getAttribute('data-pricing') || 'ALL';
      updateList();
    });
  });

  if (aiActToggle) {
    aiActToggle.addEventListener('change', () => {
      aiActOnly = aiActToggle.checked;
      updateList();
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
      updateList();
    });
  }

  if (resetSearch) {
    resetSearch.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchTerm = '';
      activeCategory = 'ALL';
      activePricing = 'ALL';
      aiActOnly = false;
      if (aiActToggle) aiActToggle.checked = false;

      filterButtons[0]?.dispatchEvent(new Event('click'));
      pricingButtons[0]?.dispatchEvent(new Event('click'));
      updateList();
    });
  }
</script>
