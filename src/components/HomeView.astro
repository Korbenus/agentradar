---
import Layout from '../layouts/Layout.astro';
import AgentCard from './AgentCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, defaultLang, type SupportedLang } from '../i18n/translations';
import { getLocalizedAgent } from '../i18n/agentData';
import { getLocalizedCategoryName } from '../utils/localizedCategories';
import { editorialCopy } from '../lib/editorial';
interface Props { lang?: SupportedLang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const copy = editorialCopy(lang);
const agents = (await getCollection('agents')).sort((a,b) => a.data.name.localeCompare(b.data.name));
const categories = [...new Set(agents.map(a => a.data.category))];
const prefix = lang === defaultLang ? '' : `/${lang}`;
---
<Layout lang={lang}>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 pt-12 pb-10 md:pt-20 text-center space-y-6">
    <p class="text-radar-400 text-sm font-bold">{t('hero.badge')}</p>
    <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-tight">{t('hero.title')} <span class="text-radar-400">{t('hero.titleHighlight')}</span> {t('hero.titleEnd')}</h1>
    <p class="text-lg text-slate-200 leading-relaxed">{t('hero.subtitle')}</p>
    <div class="p-4 rounded-2xl bg-dark-900 border border-dark-800 text-sm text-slate-300 space-y-2">
      <p>{copy.notice}</p>
      <div class="flex flex-wrap justify-center gap-5"><a href={`${prefix}/methodology`} class="underline text-radar-400">{copy.methodology}</a><a href={`${prefix}/about`} class="underline text-radar-400">{copy.about}</a></div>
    </div>
  </section>
  <section id="explore" class="max-w-7xl mx-auto px-4 sm:px-6 pb-16 space-y-6">
    <div class="p-5 rounded-3xl bg-dark-900 border border-dark-800 space-y-4">
      <label for="searchInput" class="sr-only">{t('hero.searchPlaceholder')}</label>
      <input type="search" id="searchInput" placeholder={t('hero.searchPlaceholder')} class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white placeholder-slate-400" />
      <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
        {[{value:'ALL',label:t('filter.all')}, ...categories.map(value => ({value,label:getLocalizedCategoryName(value,lang)}))].map((category,index) => <button type="button" aria-pressed={index===0 ? 'true' : 'false'} data-category={category.value} class={`filter-btn rounded-xl px-3 py-3 font-bold text-sm border ${index===0 ? 'active bg-radar-500 text-slate-950 border-radar-400' : 'bg-dark-950 text-slate-200 border-dark-700'}`}>{category.label}</button>)}
      </div>
    </div>
    <div class="flex gap-3 items-center"><h2 class="text-2xl font-bold text-white">{t('section.allAgents')}</h2><span id="agentCount" class="text-sm text-slate-400" aria-live="polite">{agents.length}</span></div>
    <div id="agentsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {agents.map(agent => <div class="agent-item" data-category={agent.data.category} data-search={`${agent.data.name} ${getLocalizedAgent(agent,lang).tagline} ${getLocalizedCategoryName(agent.data.category,lang)}`.toLocaleLowerCase()}><AgentCard agent={agent} lang={lang} /></div>)}
    </div>
    <div id="noResults" class="hidden text-center text-slate-300 py-8"><p>{t('section.noResults')}</p><button type="button" id="resetSearch" class="mt-4 text-radar-400 underline">{t('section.resetSearch')}</button></div>
  </section>
</Layout>
<script>
  const input = document.querySelector<HTMLInputElement>('#searchInput');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.agent-item');
  let category = 'ALL';
  function update() {
    const query = (input?.value || '').trim().toLocaleLowerCase();
    let count = 0;
    items.forEach(item => {
      const visible = (category === 'ALL' || item.dataset.category === category) && (!query || item.dataset.search?.includes(query));
      item.hidden = !visible;
      if (visible) count++;
    });
    const counter = document.getElementById('agentCount');
    if (counter) counter.textContent = String(count);
    document.getElementById('noResults')?.classList.toggle('hidden', count !== 0);
  }
  buttons.forEach(button => button.addEventListener('click', () => {
    category = button.dataset.category || 'ALL';
    buttons.forEach(item => {
      const active = item === button;
      item.setAttribute('aria-pressed', String(active));
      item.classList.toggle('active', active);
      item.classList.toggle('bg-radar-500', active);
      item.classList.toggle('text-slate-950', active);
      item.classList.toggle('bg-dark-950', !active);
      item.classList.toggle('text-slate-200', !active);
    });
    update();
  }));
  input?.addEventListener('input', update);
  document.getElementById('resetSearch')?.addEventListener('click', () => {
    if (input) input.value = '';
    buttons[0]?.click();
  });
</script>
