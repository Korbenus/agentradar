---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { defaultLang, type SupportedLang } from '../i18n/translations';
import { getLocalizedAgent } from '../i18n/agentData';
import { editorialCopy, outbound } from '../lib/editorial';
interface Props { lang?: SupportedLang }
const { lang = defaultLang } = Astro.props;
const copy = editorialCopy(lang);
const agents = (await getCollection('agents')).sort((a,b) => a.data.name.localeCompare(b.data.name));
const prefix = lang === defaultLang ? '' : `/${lang}`;
const agentsMap = Object.fromEntries(agents.map(agent => [agent.id, { ...getLocalizedAgent(agent,lang), link: outbound(agent.data), profile: `${prefix}/agents/${agent.id}` }]));
const labels = { ...copy, chooseA: lang === 'fr' ? 'Premier outil' : 'First tool', chooseB: lang === 'fr' ? 'Deuxième outil' : 'Second tool' };
---
<Layout lang={lang} title={`${copy.compare} | AgentRadar`} description={copy.notice}>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <h1 class="text-4xl font-bold text-white">{copy.compare}</h1>
    <p class="text-slate-300">{copy.notice} <a href={`${prefix}/methodology`} class="text-radar-400 underline">{copy.methodology}</a></p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {[['selectAgentA',labels.chooseA],['selectAgentB',labels.chooseB]].map(([id,label],i) => <div><label for={id} class="block text-slate-300 mb-2">{label}</label><select id={id} class="w-full px-4 py-3 rounded-xl bg-dark-900 border border-dark-700 text-white">{agents.map((agent,index) => <option value={agent.id} selected={index===i}>{agent.data.name}</option>)}</select></div>)}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6"><article id="colA" class="p-6 rounded-3xl bg-dark-900 border border-dark-800 space-y-5"></article><article id="colB" class="p-6 rounded-3xl bg-dark-900 border border-dark-800 space-y-5"></article></div>
    <noscript><p class="text-slate-300">{lang === 'fr' ? 'Le comparateur interactif nécessite JavaScript. Les fiches restent accessibles ci-dessous.' : 'The interactive comparison requires JavaScript. Individual profiles remain available below.'}</p></noscript>
    <ul class="flex flex-wrap gap-4">{agents.map(agent => <li><a class="text-radar-400 underline" href={`${prefix}/agents/${agent.id}`}>{agent.data.name}</a></li>)}</ul>
  </section>
</Layout>
<script is:inline define:vars={{ agentsMap, labels }}>
  const selectA = document.getElementById('selectAgentA');
  const selectB = document.getElementById('selectAgentB');
  function add(parent, tag, text, className) {
    const element = document.createElement(tag);
    element.textContent = text;
    if (className) element.className = className;
    parent.appendChild(element);
    return element;
  }
  function render(id, key) {
    const container = document.getElementById(id);
    const data = Object.prototype.hasOwnProperty.call(agentsMap,key) ? agentsMap[key] : null;
    if (!container || !data) return;
    container.replaceChildren();
    add(container,'h2',data.name,'text-2xl font-bold text-white');
    add(container,'p',data.tagline,'text-slate-200');
    add(container,'p',labels.documentary,'text-sm text-radar-400');
    [[labels.capabilities,data.keyFeatures],[labels.considerations,data.considerations]].forEach(([title,values]) => {
      add(container,'h3',title,'text-lg font-semibold text-white');
      const list = add(container,'ul','','list-disc pl-5 space-y-2 text-slate-200');
      values.forEach(value => add(list,'li',value));
    });
    add(container,'h3',labels.target,'font-semibold text-white');
    add(container,'p',data.targetAudience,'text-slate-200');
    add(container,'p',`${labels.reviewed}: ${data.lastReviewed}`,'text-xs text-slate-400');
    [[labels.pricing,data.pricingUrl,'noopener noreferrer'],[labels.visit,data.link.url,data.link.rel],[labels.profile,data.profile,null]].forEach(([title,url,rel]) => {
      const a = add(container,'a',title,'block text-radar-400 underline');
      a.href = url;
      if (rel) { a.rel = rel; a.target = '_blank'; }
    });
    add(container,'p',data.link.affiliate ? labels.affiliate : labels.noAffiliate,'text-xs text-slate-400');
  }
  function update() {
    render('colA',selectA.value); render('colB',selectB.value);
    const url = new URL(window.location.href);
    url.searchParams.set('a',selectA.value); url.searchParams.set('b',selectB.value);
    window.history.replaceState({},'',url);
  }
  const params = new URLSearchParams(window.location.search);
  const paramA = params.get('a');
  const paramB = params.get('b');
  if (paramA && Object.prototype.hasOwnProperty.call(agentsMap,paramA)) selectA.value = paramA;
  if (paramB && Object.prototype.hasOwnProperty.call(agentsMap,paramB)) selectB.value = paramB;
  selectA.addEventListener('change',update); selectB.addEventListener('change',update); update();
</script>
