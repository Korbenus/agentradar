---
import Layout from '../layouts/Layout.astro';
import AgentCard from './AgentCard.astro';
import { render, type CollectionEntry } from 'astro:content';
import { defaultLang, type SupportedLang } from '../i18n/translations';
import { getLocalizedAgent } from '../i18n/agentData';
import { getLocalizedCategoryName } from '../utils/localizedCategories';
import { editorialCopy, outbound } from '../lib/editorial';
interface Props { agent: CollectionEntry<'agents'>; allAgents: CollectionEntry<'agents'>[]; lang?: SupportedLang }
const { agent, allAgents, lang = defaultLang } = Astro.props;
const data = getLocalizedAgent(agent, lang);
const { Content } = await render(agent);
const copy = editorialCopy(lang);
const link = outbound(agent.data);
const prefix = lang === defaultLang ? '' : `/${lang}`;
const related = allAgents.filter(a => a.id !== agent.id && a.data.category === data.category).slice(0, 3);
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: `${data.name} — ${copy.documentary}`, description: data.tagline, datePublished: data.dateAdded, dateModified: data.lastReviewed, citation: data.sources.map(s => s.url), author: { '@type': 'Organization', name: 'AgentRadar', url: new URL(`${prefix}/about`, Astro.site).href } };
---
<Layout lang={lang} title={`${data.name} — ${copy.documentary} | AgentRadar`} description={data.tagline}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\u003c')} />
  <article class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <nav class="text-sm text-slate-400"><a href={`${prefix}/`}>AgentRadar</a> / {getLocalizedCategoryName(data.category, lang)}</nav>
    <header class="space-y-4">
      <p class="text-radar-400 text-sm font-semibold">{copy.documentary}</p>
      <h1 class="text-4xl font-extrabold text-white">{data.name}</h1>
      <p class="text-lg text-slate-200">{data.tagline}</p>
      <p class="text-xs text-slate-400">AgentRadar · {copy.reviewed} <time datetime={data.lastReviewed}>{data.lastReviewed}</time></p>
    </header>
    <div class="p-5 rounded-2xl border border-radar-500/30 bg-dark-900 space-y-2 text-sm text-slate-200">
      <p>{copy.notice}</p>
      <a class="underline text-radar-400" href={`${prefix}/methodology`}>{copy.methodology}</a>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <section class="p-6 rounded-2xl bg-dark-900 border border-dark-800 space-y-4">
          <h2 class="text-xl font-bold text-white">{copy.capabilities}</h2>
          <ul class="list-disc pl-5 text-slate-200 space-y-2">{data.keyFeatures.map(item => <li>{item}</li>)}</ul>
        </section>
        <section class="p-6 rounded-2xl bg-dark-900 border border-dark-800 space-y-4">
          <h2 class="text-xl font-bold text-white">{copy.considerations}</h2>
          <ul class="list-disc pl-5 text-slate-200 space-y-2">{data.considerations.map(item => <li>{item}</li>)}</ul>
          <p class="text-sm text-slate-400">{copy.compliance}</p>
        </section>
        <section class="p-6 rounded-2xl bg-dark-900 border border-dark-800 space-y-4">
          <h2 class="text-xl font-bold text-white">{copy.target}</h2>
          <p class="text-slate-200">{data.targetAudience}</p>
        </section>
        <section class="p-6 rounded-2xl bg-dark-900 border border-dark-800 space-y-4">
          {lang === 'fr' && data.evaluationScenario ? <><h2 class="text-xl font-bold text-white">{copy.scenario}</h2><p class="text-slate-200 leading-relaxed">{data.evaluationScenario}</p><p class="text-sm text-slate-400">{copy.scenarioNotice}</p></> : <div lang="en" class="prose-editorial"><Content /></div>}
        </section>
        <section id="sources" class="p-6 rounded-2xl bg-dark-900 border border-dark-800 space-y-4">
          <h2 class="text-xl font-bold text-white">{copy.sources}</h2>
          <ul class="list-disc pl-5 space-y-3">{data.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer" class="text-radar-400 underline break-words">{source.title} — {new URL(source.url).hostname}</a></li>)}</ul>
          <p class="text-xs text-slate-400">{copy.reviewed} : {data.lastReviewed}</p>
        </section>
      </div>
      <aside class="space-y-4 h-fit lg:sticky lg:top-24 p-6 rounded-2xl bg-dark-900 border border-dark-800">
        <a href={link.url} target="_blank" rel={link.rel} class="block text-center px-5 py-3 rounded-xl bg-radar-400 text-slate-950 font-bold">{copy.visit} ↗</a>
        <a href={data.pricingUrl} target="_blank" rel="noopener noreferrer" class="block text-center text-radar-400 underline">{copy.pricing} ↗</a>
        <p class="text-xs text-slate-400">{link.affiliate ? copy.affiliate : copy.noAffiliate}</p>
        <a href={`${prefix}/compare?a=${data.slug}`} class="block text-center text-slate-200 underline">{copy.compare}</a>
      </aside>
    </div>
    {related.length > 0 && <section class="space-y-5"><h2 class="text-2xl font-bold text-white">{copy.related}</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-6">{related.map(a => <AgentCard agent={a} lang={lang} />)}</div></section>}
  </article>
</Layout>
