---
import Layout from '../layouts/Layout.astro';
import AgentCard from './AgentCard.astro';
import { render, type CollectionEntry } from 'astro:content';
import { useTranslations, type SupportedLang, defaultLang } from '../i18n/translations';
import { getLocalizedAgent } from '../i18n/agentData';
import { getCategorySlug } from '../utils/categories';
import { getLocalizedCategoryName } from '../utils/localizedCategories';
import { getAgentLogoUrl, getAgentMonogram, getTechnicalScores } from '../utils/brand';

interface Props {
  agent: CollectionEntry<'agents'>;
  allAgents: CollectionEntry<'agents'>[];
  lang?: SupportedLang;
}

const { agent, allAgents, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(agent);

// Find top alternative in same category
const sameCategoryAgents = allAgents.filter(
  a => a.id !== agent.id && a.data.category === agent.data.category
);
const topAlternative = sameCategoryAgents[0] || allAgents.find(a => a.id !== agent.id);
const relatedAgents = sameCategoryAgents.slice(0, 3);

const loc = getLocalizedAgent(agent, lang);
const altLoc = topAlternative ? getLocalizedAgent(topAlternative, lang) : null;

const {
  name,
  tagline,
  category,
  rating,
  pricingModel,
  priceStartingAt,
  websiteUrl,
  affiliateUrl,
  badge,
  aiActCompliant,
  dateAdded,
  pros,
  cons,
  keyFeatures,
  targetAudience,
  overviewSummary,
  faqs: customFaqs,
} = loc;

const targetUrl = affiliateUrl || websiteUrl;

function localizedHref(path: string): string {
  if (lang === defaultLang) return path;
  if (path === '/') return `/${lang}`;
  return `/${lang}${path}`;
}

const categorySlug = getCategorySlug(category);
const altSlug = topAlternative ? topAlternative.id.replace(/\.md$/, '') : '';
const altUrl = topAlternative ? localizedHref(`/agents/${altSlug}`) : '';
const logoUrl = getAgentLogoUrl(websiteUrl);
const monogram = getAgentMonogram(name);
const scores = getTechnicalScores(rating, aiActCompliant);

// 3 Custom FAQs for the agent
const faqs = customFaqs || (lang === 'fr' ? [
  {
    q: `Est-ce que ${name} propose un essai gratuit ou une version freemium ?`,
    a: pricingModel.toLowerCase().includes('freemium') || pricingModel.toLowerCase().includes('gratuit')
      ? `Oui ! ${name} propose une formule ${pricingModel}, permettant d'évaluer ses capacités avant tout engagement.`
      : `${name} fonctionne sur un modèle ${pricingModel} avec des forfaits débutant à ${priceStartingAt}. Consultez leur site officiel pour connaître les conditions d'essai.`
  },
  {
    q: `Est-ce que ${name} est conforme au RGPD et à l'EU AI Act ?`,
    a: aiActCompliant
      ? `Oui. ${name} intègre des mécanismes stricts de traçabilité et de sécurité des données conformes aux normes européennes.`
      : `${name} applique les protocoles de sécurité cloud standards. Consultez leur politique de confidentialité pour les garanties d'hébergement européen.`
  },
  {
    q: `Quelle est la meilleure alternative à ${name} ?`,
    a: topAlternative 
      ? `Une excellente alternative dans la catégorie "${category}" est ${topAlternative.data.name} (à partir de ${topAlternative.data.priceStartingAt}, noté ★ ${topAlternative.data.rating.toFixed(1)}).`
      : `Explorez notre répertoire "${category}" pour comparer les solutions alternatives.`
  }
] : [
  {
    q: `Does ${name} offer a free trial or free tier?`,
    a: pricingModel.toLowerCase().includes('freemium') || pricingModel.toLowerCase().includes('gratuit')
      ? `Yes! ${name} features a ${pricingModel} model, allowing teams to explore core capabilities before upgrading.`
      : `${name} operates on a ${pricingModel} model with plans starting at ${priceStartingAt}. Reach out via their official link to verify trial periods.`
  },
  {
    q: `Is ${name} compliant with GDPR and the EU AI Act?`,
    a: aiActCompliant
      ? `Yes. ${name} incorporates transparent operational logging and enterprise data boundary safeguards aligned with European Union regulatory standards.`
      : `${name} provides standard cloud security protocols. Consult their enterprise privacy policy for specific sovereign European data residency guarantees.`
  },
  {
    q: `What is the best alternative to ${name}?`,
    a: topAlternative 
      ? `A highly-rated alternative in the "${category}" space is ${topAlternative.data.name} (starting at ${topAlternative.data.priceStartingAt}, rated ★ ${topAlternative.data.rating.toFixed(1)}).`
      : `Explore our "${category}" directory to compare alternative autonomous solutions.`
  }
]);

// Schema.org Structured Data: Product + FAQPage
const jsonLd = {
  "@context": "https://schema.org/",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": name,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Cloud / Web",
      "offers": {
        "@type": "Offer",
        "price": priceStartingAt,
        "priceCurrency": "USD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": rating,
        "bestRating": "5",
        "ratingCount": "42"
      },
      "description": tagline
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    }
  ]
};
---

<Layout
  lang={lang}
  title={`${name} : 2026 In-Depth Review, Pricing & Features | AgentRadar`}
  description={tagline}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Breadcrumb & TOC shortcut bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href={localizedHref('/')} class="hover:text-white transition">AgentRadar</a>
        <span>/</span>
        <a href={localizedHref(`/categories/${categorySlug}`)} class="hover:text-white transition">{getLocalizedCategoryName(category, lang)}</a>
        <span>/</span>
        <span class="text-slate-200">{name}</span>
      </nav>

      <!-- Mini Table of Contents Quick Nav -->
      <div class="flex items-center gap-1.5 overflow-x-auto text-[11px] font-semibold text-slate-300 scrollbar-none py-1">
        <a href="#overview" class="px-2.5 py-1.5 rounded-lg bg-dark-900 border border-dark-800 hover:border-slate-700 hover:text-radar-400 transition flex items-center gap-1">
          <span>📌</span>
          <span>{t('toc.overview')}</span>
        </a>
        <a href="#pros-cons" class="px-2.5 py-1.5 rounded-lg bg-dark-900 border border-dark-800 hover:border-slate-700 hover:text-radar-400 transition flex items-center gap-1">
          <span>⚖️</span>
          <span>{t('toc.prosCons')}</span>
        </a>
        <a href="#features" class="px-2.5 py-1.5 rounded-lg bg-dark-900 border border-dark-800 hover:border-slate-700 hover:text-radar-400 transition flex items-center gap-1">
          <span>⚙️</span>
          <span>{t('toc.features')}</span>
        </a>
        {topAlternative && (
          <a href="#alternative" class="px-2.5 py-1.5 rounded-lg bg-dark-900 border border-dark-800 hover:border-slate-700 hover:text-radar-400 transition flex items-center gap-1">
            <span>⚡</span>
            <span>{t('alt.heading')}</span>
          </a>
        )}
        <a href="#faq" class="px-2.5 py-1.5 rounded-lg bg-dark-900 border border-dark-800 hover:border-slate-700 hover:text-radar-400 transition flex items-center gap-1">
          <span>❓</span>
          <span>{t('toc.faq')}</span>
        </a>
      </div>
    </div>

    <!-- Header Block with Official Brand Logo -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-8 border-b border-dark-800">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
        <!-- 64x64 Official Brand Logo Box -->
        <div class="w-16 h-16 rounded-2xl bg-white p-2.5 shadow-lg border border-slate-200 flex items-center justify-center shrink-0 overflow-hidden">
          <img
            src={logoUrl}
            alt={`${name} logo`}
            width="48"
            height="48"
            class="w-11 h-11 object-contain"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <span class="hidden w-full h-full items-center justify-center font-extrabold text-lg text-slate-900 bg-emerald-100 rounded-xl">
            {monogram}
          </span>
        </div>

        <div class="space-y-2.5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold px-3 py-1 rounded-lg bg-dark-800 text-slate-200 border border-dark-700">
              {getLocalizedCategoryName(category, lang)}
            </span>
            {badge && (
              <span class="text-xs font-bold px-3 py-1 rounded-lg bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                ★ {badge}
              </span>
            )}
            {aiActCompliant && (
              <span class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-blue-500/15 text-blue-300 border border-blue-500/30 flex items-center gap-1">
                <span>🇪🇺</span>
                <span>{t('card.aiActReady')}</span>
              </span>
            )}
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
            {name}
          </h1>
          <p class="text-base sm:text-lg text-slate-200 max-w-3xl leading-relaxed font-normal">
            {tagline}
          </p>
        </div>
      </div>

      <!-- Quick Action on Top -->
      <div class="flex flex-col sm:flex-row lg:flex-col gap-2.5 shrink-0">
        <a
          href={targetUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl bg-radar-400 hover:bg-radar-300 text-slate-950 font-extrabold text-sm sm:text-base transition-all shadow-lg shadow-radar-500/20 text-center"
        >
          <span>{t('card.tryNow')} {name}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
        <span class="text-xs text-center text-slate-400 font-medium">
          {lang === 'fr' ? '✓ Site officiel vérifié' : '✓ Verified Official Website'}
        </span>
      </div>
    </div>

    <!-- Main Content 2 Columns -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mt-10">
      <!-- Left Column: Visual Scorecard, Pros/Cons, Features, Review -->
      <div class="lg:col-span-2 space-y-10">

        <!-- At-a-Glance Visual Scorecard & Executive Verdict (Inspired by G2 / Wirecutter / LesNumériques) -->
        <div id="overview" class="p-6 sm:p-8 rounded-3xl bg-dark-900 border border-dark-800 shadow-xl space-y-6 scroll-mt-24">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-dark-800">
            <div>
              <span class="text-xs font-extrabold text-radar-400 uppercase tracking-wider block mb-1">
                {lang === 'fr' ? '⚡ Verdict & Baromètre en un coup d\'œil' : '⚡ Executive Verdict & Benchmark'}
              </span>
              <h2 class="text-xl sm:text-2xl font-extrabold text-white">
                {lang === 'fr' ? `Pourquoi choisir ${name} ?` : `Why choose ${name}?`}
              </h2>
            </div>
            <div class="flex items-center gap-3 bg-dark-950 px-4 py-2.5 rounded-2xl border border-dark-800 shrink-0">
              <span class="text-2xl sm:text-3xl font-extrabold text-amber-400">★ {rating.toFixed(1)}</span>
              <div class="text-xs text-slate-300 leading-tight">
                <span class="font-bold text-white block">/ 5.0</span>
                <span>{lang === 'fr' ? 'Note Globale' : 'Overall Score'}</span>
              </div>
            </div>
          </div>

          <!-- 4 Visual Progress Bars -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-3.5 rounded-2xl bg-dark-950/70 border border-dark-800/80">
              <div class="flex justify-between text-xs sm:text-sm font-bold mb-1.5">
                <span class="text-slate-200">{lang === 'fr' ? '🤖 Autonomie d\'exécution' : '🤖 Execution Autonomy'}</span>
                <span class="text-radar-400">{scores.autonomy} / 10</span>
              </div>
              <div class="w-full h-2 bg-dark-800 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-emerald-500 to-radar-400 rounded-full" style={`width: ${scores.autonomy * 10}%`}></div>
              </div>
            </div>

            <div class="p-3.5 rounded-2xl bg-dark-950/70 border border-dark-800/80">
              <div class="flex justify-between text-xs sm:text-sm font-bold mb-1.5">
                <span class="text-slate-200">{lang === 'fr' ? '🔌 Intégrations & API' : '🔌 Ecosystem & API'}</span>
                <span class="text-radar-400">{scores.integration} / 10</span>
              </div>
              <div class="w-full h-2 bg-dark-800 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-emerald-500 to-radar-400 rounded-full" style={`width: ${scores.integration * 10}%`}></div>
              </div>
            </div>

            <div class="p-3.5 rounded-2xl bg-dark-950/70 border border-dark-800/80">
              <div class="flex justify-between text-xs sm:text-sm font-bold mb-1.5">
                <span class="text-slate-200">{lang === 'fr' ? '💰 Rentabilité (ROI)' : '💰 Return on Investment'}</span>
                <span class="text-radar-400">{scores.roi} / 10</span>
              </div>
              <div class="w-full h-2 bg-dark-800 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-emerald-500 to-radar-400 rounded-full" style={`width: ${scores.roi * 10}%`}></div>
              </div>
            </div>

            <div class="p-3.5 rounded-2xl bg-dark-950/70 border border-dark-800/80">
              <div class="flex justify-between text-xs sm:text-sm font-bold mb-1.5">
                <span class="text-slate-200">{lang === 'fr' ? '🛡️ Sécurité & Conformité UE' : '🛡️ EU Security & Privacy'}</span>
                <span class="text-radar-400">{scores.security} / 10</span>
              </div>
              <div class="w-full h-2 bg-dark-800 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-emerald-500 to-radar-400 rounded-full" style={`width: ${scores.security * 10}%`}></div>
              </div>
            </div>
          </div>

          {overviewSummary && (
            <div class="p-5 rounded-2xl bg-dark-950/90 border border-radar-500/30">
              <span class="text-xs font-extrabold text-radar-400 uppercase tracking-wider block mb-1.5">
                {lang === 'fr' ? '💡 En bref : L\'avis de la rédaction' : '💡 Bottom Line: Editorial Verdict'}
              </span>
              <p class="text-[15px] sm:text-base text-slate-100 leading-relaxed font-normal">
                {overviewSummary}
              </p>
            </div>
          )}
        </div>

        <!-- Pros and Cons Grid (High Legibility 15px) -->
        <div id="pros-cons" class="grid grid-cols-1 md:grid-cols-2 gap-6 scroll-mt-24">
          <!-- Pros -->
          <div class="p-6 sm:p-7 rounded-3xl bg-dark-900 border border-emerald-500/30 shadow-lg">
            <h3 class="text-base font-extrabold text-emerald-400 uppercase tracking-wider mb-5 flex items-center gap-2.5">
              <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-emerald-500/20 text-emerald-400 text-sm">👍</span>
              <span>{t('card.pros')}</span>
            </h3>
            <ul class="space-y-3.5 text-sm sm:text-[15px] text-slate-100">
              {pros.map((pro: string) => (
                <li class="flex items-start gap-3">
                  <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 font-extrabold text-xs shrink-0 mt-0.5">✓</span>
                  <span class="leading-relaxed">{pro}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Cons -->
          <div class="p-6 sm:p-7 rounded-3xl bg-dark-900 border border-rose-500/30 shadow-lg">
            <h3 class="text-base font-extrabold text-rose-400 uppercase tracking-wider mb-5 flex items-center gap-2.5">
              <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-rose-500/20 text-rose-400 text-sm">⚠️</span>
              <span>{t('card.cons')}</span>
            </h3>
            <ul class="space-y-3.5 text-sm sm:text-[15px] text-slate-100">
              {cons.map((con: string) => (
                <li class="flex items-start gap-3">
                  <span class="flex h-5 w-5 items-center justify-center rounded-full bg-rose-500/20 text-rose-400 font-extrabold text-xs shrink-0 mt-0.5">-</span>
                  <span class="leading-relaxed">{con}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Key features checklist -->
        <div id="features" class="p-6 sm:p-8 rounded-3xl bg-dark-900 border border-dark-800 scroll-mt-24 shadow-lg">
          <h3 class="text-lg sm:text-xl font-extrabold text-white mb-5 flex items-center gap-2.5">
            <span>⚙️</span>
            <span>{t('card.features')}</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-sm sm:text-[15px] text-slate-100">
            {keyFeatures.map((feat: string) => (
              <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-dark-950/80 border border-dark-800">
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-radar-500/20 text-radar-400 font-extrabold text-xs shrink-0">✓</span>
                <span class="leading-snug font-medium">{feat}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Rendered Markdown Body inside Formatted Editorial Container -->
        <div class="p-6 sm:p-8 rounded-3xl bg-dark-900 border border-dark-800 shadow-lg">
          <div class="prose-editorial max-w-none">
            <Content />
          </div>
        </div>

        <!-- Recommended Alternative Callout Card -->
        {topAlternative && (
          <div id="alternative" class="p-6 rounded-2xl bg-gradient-to-r from-dark-900 via-dark-900 to-radar-950/30 border border-radar-500/30 shadow-lg scroll-mt-24 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="space-y-2">
              <span class="text-[11px] font-bold text-radar-400 uppercase tracking-wider">{t('alt.heading')}</span>
              <h4 class="text-lg font-bold text-white">{topAlternative.data.name}</h4>
              <p class="text-xs text-slate-400 max-w-lg leading-relaxed">{altLoc ? altLoc.tagline : topAlternative.data.tagline}</p>
              <div class="flex items-center gap-3 text-xs pt-1">
                <span class="text-amber-400 font-semibold">★ {topAlternative.data.rating.toFixed(1)}</span>
                <span class="text-slate-500">•</span>
                <span class="text-slate-300 font-medium">{topAlternative.data.priceStartingAt}</span>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <a
                href={altUrl}
                class="px-4 py-2 rounded-xl bg-dark-800 hover:bg-dark-700 text-white font-semibold text-xs transition border border-dark-700"
              >
                {t('card.fullReview')} →
              </a>
              <a
                href={localizedHref(`/compare?a=${agent.id.replace(/\.md$/, '')}&b=${altSlug}`)}
                class="px-4 py-2 rounded-xl bg-radar-500/10 hover:bg-radar-500/20 text-radar-400 font-semibold text-xs transition border border-radar-500/30 flex items-center gap-1.5"
              >
                <span>{t('compare.pageTitle')} ⚡</span>
              </a>
            </div>
          </div>
        )}

        <!-- Target Audience Callout -->
        <div class="p-6 rounded-2xl bg-gradient-to-r from-emerald-950/30 to-dark-900 border border-emerald-500/30">
          <h4 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-2">{t('card.targetAudience')}</h4>
          <p class="text-sm text-slate-200 leading-relaxed">
            {targetAudience}
          </p>
        </div>

        <!-- Interactive FAQ Accordion -->
        <div id="faq" class="p-6 sm:p-8 rounded-2xl bg-dark-900/60 border border-dark-800 space-y-4 scroll-mt-24">
          <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
            <span>❓</span>
            <span>{t('faq.heading')} : {name}</span>
          </h3>

          <div class="space-y-3">
            {faqs.map((faq) => (
              <details class="group p-4 rounded-xl bg-dark-950 border border-dark-800 hover:border-slate-700 transition-colors">
                <summary class="font-bold text-sm text-slate-200 group-open:text-radar-400 cursor-pointer list-none flex items-center justify-between">
                  <span>{faq.q}</span>
                  <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <p class="mt-3 text-xs sm:text-sm text-slate-400 leading-relaxed pt-2 border-t border-dark-800/60">
                  {faq.a}
                </p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Sticky Summary & Affiliate Box -->
      <div class="space-y-6">
        <div id="pricing" class="sticky top-24 p-6 rounded-2xl bg-dark-900 border border-dark-800 shadow-xl space-y-6 scroll-mt-24">
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase font-semibold text-slate-400">{t('card.techRating')}</span>
            <div class="flex items-center gap-1 text-sm font-bold text-amber-400 bg-amber-400/10 px-2.5 py-1 rounded-md">
              <span>★</span>
              <span>{rating.toFixed(1)} / 5</span>
            </div>
          </div>

          <div class="border-t border-dark-800 pt-4 space-y-3 text-xs sm:text-sm">
            <div class="flex justify-between">
              <span class="text-slate-400">{t('card.pricingModel')} :</span>
              <span class="font-semibold text-white">{pricingModel}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">{t('card.startingPrice')} :</span>
              <span class="font-bold text-radar-400">{priceStartingAt}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">{t('card.category')} :</span>
              <span class="text-slate-200">{category}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">EU AI Act :</span>
              <span class="text-emerald-400 font-semibold">{aiActCompliant ? 'Ready' : 'Pending'}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">{t('card.lastVerified')} :</span>
              <span class="text-slate-400">{dateAdded}</span>
            </div>
          </div>

          <div class="pt-4 border-t border-dark-800 space-y-3">
            <a
              href={targetUrl}
              target="_blank"
              rel="sponsored noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-radar-500 hover:bg-radar-400 text-black font-bold text-sm transition-all shadow-lg shadow-radar-500/20 text-center"
            >
              <span>{t('card.tryNow')} {name}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </a>

            <a
              href={topAlternative ? localizedHref(`/compare?a=${agent.id.replace(/\.md$/, '')}&b=${altSlug}`) : localizedHref(`/compare?a=${agent.id.replace(/\.md$/, '')}`)}
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-dark-950 hover:bg-dark-800 text-slate-300 hover:text-white font-medium text-xs transition border border-dark-800 text-center"
            >
              <span>⚡ {t('compare.pageTitle')}</span>
            </a>

            <p class="text-[10px] text-center text-slate-500">
              {t('card.affiliateDisclaimer')}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Agents Section -->
    {relatedAgents.length > 0 && (
      <div class="mt-24 pt-12 border-t border-dark-800">
        <h2 class="text-2xl font-bold text-white mb-8">
          {t('card.related')} « {category} »
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedAgents.map((rel) => (
            <AgentCard agent={rel} lang={lang} />
          ))}
        </div>
      </div>
    )}
  </article>
</Layout>
