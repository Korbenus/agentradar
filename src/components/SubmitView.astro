---
import Layout from '../layouts/Layout.astro';
import { useTranslations, type SupportedLang, defaultLang } from '../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  title={`${t('submit.title')} | AgentRadar`}
  description={t('submit.subtitle')}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-bold text-radar-400 uppercase tracking-wider block mb-2">{t('submit.badge')}</span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        {t('submit.title')}
      </h1>
      <p class="mt-4 text-base text-slate-300 leading-relaxed">
        {t('submit.subtitle')}
      </p>
    </div>

    <!-- Pricing Options for listing -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Free Option -->
      <div class="p-8 rounded-2xl bg-dark-900 border border-dark-800 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase text-slate-400">{t('submit.standard')}</span>
          <h3 class="text-2xl font-bold text-white mt-1">{t('submit.standardTitle')}</h3>
          <p class="text-xs text-slate-400 mt-2">{t('submit.standardDesc')}</p>
          <div class="text-3xl font-extrabold text-white mt-6">$0</div>

          <ul class="mt-6 space-y-3 text-xs text-slate-300">
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> Permanent Dedicated Review Page
            </li>
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> DoFollow SEO Backlink & Indexing
            </li>
            <li class="flex items-center gap-2 text-slate-500">
              <span>⏳</span> Turnaround: 10 to 20 days
            </li>
          </ul>
        </div>

        <a
          href="#form"
          class="mt-8 block text-center py-3 px-4 rounded-xl bg-dark-800 hover:bg-dark-700 text-white font-semibold text-xs transition"
        >
          {t('submit.standardFree')}
        </a>
      </div>

      <!-- Paid Fast Track Option -->
      <div class="p-8 rounded-2xl bg-gradient-to-b from-dark-900 via-dark-900 to-emerald-950/30 border border-radar-500/40 shadow-xl shadow-radar-500/5 relative flex flex-col justify-between">
        <div class="absolute -top-3 right-6 px-3 py-1 bg-radar-500 text-black font-bold text-[10px] rounded-full uppercase tracking-wider">
          {t('submit.recommended')}
        </div>

        <div>
          <span class="text-xs font-bold uppercase text-radar-400">{t('submit.fastTrack')}</span>
          <h3 class="text-2xl font-bold text-white mt-1">{t('submit.fastTrackTitle')}</h3>
          <p class="text-xs text-slate-300 mt-2">{t('submit.fastTrackDesc')}</p>
          <div class="text-3xl font-extrabold text-radar-400 mt-6">$49 <span class="text-xs font-normal text-slate-400">{t('submit.oneTime')}</span></div>

          <ul class="mt-6 space-y-3 text-xs text-slate-200">
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> Guaranteed Publication in 24 Hours
            </li>
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> "★ Editorial Selection" Featured Badge
            </li>
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> Broadcasted in Daily RSS & Newsletter
            </li>
            <li class="flex items-center gap-2">
              <span class="text-radar-400">✓</span> Custom Conversion Button & Tracking
            </li>
          </ul>
        </div>

        <a
          href="#form"
          class="mt-8 block text-center py-3 px-4 rounded-xl bg-radar-500 hover:bg-radar-400 text-black font-bold text-xs transition shadow-lg shadow-radar-500/20"
        >
          {t('submit.fastTrackPaid')}
        </a>
      </div>
    </div>

    <!-- Form -->
    <div id="form" class="p-8 sm:p-10 rounded-3xl bg-dark-900/80 border border-dark-800 shadow-2xl">
      <h3 class="text-xl font-bold text-white mb-6">{t('submit.formTitle')}</h3>

      <form action="https://formspree.io/f/placeholder" method="POST" class="space-y-6">
        <!-- Anti-Spam Bot Honeypot -->
        <input type="text" name="_gotcha" class="hidden" style="display:none !important;" tabindex="-1" autocomplete="off" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">{t('submit.agentName')}</label>
            <input type="text" name="name" required placeholder="Ex. NexusAgent" class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white text-sm focus:outline-none focus:border-radar-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">{t('submit.websiteUrl')}</label>
            <input type="url" name="url" required placeholder="https://..." class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white text-sm focus:outline-none focus:border-radar-500" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">{t('submit.mainCategory')}</label>
            <select name="category" class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white text-sm focus:outline-none focus:border-radar-500">
              <option>{t('cat.codeDev')}</option>
              <option>{t('cat.supportClient')}</option>
              <option>{t('cat.prospectionB2B')}</option>
              <option>{t('cat.productiviteAssistant')}</option>
              <option>{t('cat.comptabiliteFinance')}</option>
              <option>{t('cat.conformiteJuridique')}</option>
              <option>{t('cat.marketingContenu')}</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">{t('submit.contactEmail')}</label>
            <input type="email" name="email" required placeholder="founder@your-saas.com" class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white text-sm focus:outline-none focus:border-radar-500" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-2">{t('submit.description')}</label>
          <textarea name="description" rows="3" required placeholder="What autonomous workflow does your agent execute?" class="w-full px-4 py-3 rounded-xl bg-dark-950 border border-dark-700 text-white text-sm focus:outline-none focus:border-radar-500"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-2">{t('submit.reviewOption')}</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="flex items-center gap-3 p-4 rounded-xl bg-dark-950 border border-dark-700 cursor-pointer hover:border-slate-500 transition">
              <input type="radio" name="plan" value="free" checked class="text-radar-500 focus:ring-radar-500" />
              <div>
                <span class="block text-xs font-bold text-white">{t('submit.standard')} ($0)</span>
                <span class="block text-[11px] text-slate-400">Regular review queue</span>
              </div>
            </label>
            <label class="flex items-center gap-3 p-4 rounded-xl bg-dark-950 border border-radar-500/40 cursor-pointer hover:border-radar-500 transition">
              <input type="radio" name="plan" value="fasttrack" class="text-radar-500 focus:ring-radar-500" />
              <div>
                <span class="block text-xs font-bold text-radar-400">{t('submit.fastTrack')} ($49)</span>
                <span class="block text-[11px] text-slate-300">Live in 24h + Homepage Featured</span>
              </div>
            </label>
          </div>
        </div>

        <button
          type="submit"
          class="w-full py-4 rounded-xl bg-radar-500 hover:bg-radar-400 text-black font-bold text-sm transition-all shadow-lg shadow-radar-500/20 cursor-pointer"
        >
          {t('submit.sendBtn')}
        </button>
      </form>
    </div>
  </div>
</Layout>
