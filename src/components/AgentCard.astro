---
import { useTranslations, type SupportedLang, defaultLang } from '../i18n/translations';
import { getLocalizedAgent } from '../i18n/agentData';
import { getLocalizedCategoryName } from '../utils/localizedCategories';
import { getAgentLogoUrl, getAgentMonogram } from '../utils/brand';

interface Props {
  agent: any;
  lang?: SupportedLang;
}

const { agent, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const localized = getLocalizedAgent(agent, lang);
const { name, tagline, category, rating, pricingModel, priceStartingAt, affiliateUrl, websiteUrl, badge, featured, aiActCompliant, pros } = localized;
const targetUrl = affiliateUrl || websiteUrl;

const cleanSlug = (agent.id || agent.slug || '').replace(/\.md$/, '');
const detailUrl = lang === defaultLang ? `/agents/${cleanSlug}` : `/${lang}/agents/${cleanSlug}`;
const localizedCategory = getLocalizedCategoryName(category, lang);
const logoUrl = getAgentLogoUrl(websiteUrl);
const monogram = getAgentMonogram(name);
const topPros = (pros || []).slice(0, 2);
---

<article class={`agent-card relative group flex flex-col justify-between p-6 rounded-3xl bg-dark-900 border transition-all duration-300 hover:shadow-2xl hover:-translate-y-1 ${
  featured 
    ? 'border-radar-500/50 shadow-lg shadow-radar-500/5 ring-1 ring-radar-500/25' 
    : 'border-dark-800 hover:border-radar-500/40'
}`}>
  <div>
    <!-- Header: Brand Logo + Title + Rating -->
    <div class="flex items-start justify-between gap-3 mb-4">
      <div class="flex items-center gap-3.5 min-w-0">
        <!-- Official Brand Logo with Monogram Fallback -->
        <div class="relative w-12 h-12 rounded-2xl bg-white p-2 shadow-md border border-slate-200/80 flex items-center justify-center shrink-0 overflow-hidden">
          <img
            src={logoUrl}
            alt={`${name} logo`}
            width="36"
            height="36"
            loading="lazy"
            class="w-8 h-8 object-contain"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <span class="hidden w-full h-full items-center justify-center font-extrabold text-sm text-slate-900 bg-emerald-100 rounded-xl">
            {monogram}
          </span>
        </div>

        <div class="min-w-0">
          <h3 class="text-lg sm:text-xl font-extrabold text-white group-hover:text-radar-400 transition-colors truncate">
            <a href={detailUrl} class="focus:outline-none">
              <span class="absolute inset-0 z-0" aria-hidden="true"></span>
              {name}
            </a>
          </h3>
          <div class="flex flex-wrap items-center gap-1.5 mt-1">
            <span class="text-xs font-semibold text-slate-300 bg-dark-800 px-2.5 py-0.5 rounded-md border border-dark-700">
              {localizedCategory}
            </span>
            {badge && (
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                ★ {badge}
              </span>
            )}
          </div>
        </div>
      </div>

      <!-- Rating Score Pill -->
      <div class="flex flex-col items-end shrink-0">
        <div class="flex items-center gap-1 text-sm font-extrabold text-amber-300 bg-amber-400/15 border border-amber-400/30 px-2.5 py-1 rounded-xl shadow-sm">
          <svg class="w-4 h-4 fill-current text-amber-400" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span>{rating.toFixed(1)}</span>
        </div>
        {aiActCompliant && (
          <span class="mt-1.5 text-[11px] font-semibold px-2 py-0.5 rounded-md bg-blue-500/15 text-blue-300 border border-blue-500/30 flex items-center gap-1" title="EU AI Act compliant">
            <span>🇪🇺</span>
            <span>AI Act OK</span>
          </span>
        )}
      </div>
    </div>

    <!-- Human-Readable Pitch (15px high contrast) -->
    <p class="mt-3 text-[15px] text-slate-200 leading-relaxed font-normal">
      {tagline}
    </p>

    <!-- Scannable Key Highlights Box (Top 2 Pros) -->
    {topPros.length > 0 && (
      <ul class="mt-4 p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/25 space-y-2">
        {topPros.map((pro: string) => (
          <li class="flex items-start gap-2 text-xs sm:text-[13.5px] text-slate-100 font-medium leading-snug">
            <span class="text-emerald-400 font-extrabold shrink-0 mt-0.5">✓</span>
            <span class="line-clamp-1">{pro}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Footer: Clear Pricing & Action Buttons -->
  <div class="mt-6 pt-4 border-t border-dark-800 flex items-center justify-between gap-3 z-10 relative">
    <div>
      <div class="flex items-center gap-1.5">
        <span class="text-sm sm:text-[15px] font-extrabold text-white">{priceStartingAt}</span>
      </div>
      <span class="inline-block mt-0.5 text-xs font-bold text-radar-400">
        {pricingModel}
      </span>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={detailUrl}
        class="text-xs sm:text-sm font-bold text-white hover:text-radar-300 px-3.5 py-2.5 rounded-xl bg-dark-800 hover:bg-dark-750 border border-dark-700 hover:border-radar-500/40 transition shadow-sm"
      >
        {t('card.fullReview')}
      </a>
      <a
        href={targetUrl}
        target="_blank"
        rel="sponsored noopener noreferrer"
        class="text-xs sm:text-sm font-extrabold text-slate-950 bg-radar-400 hover:bg-radar-300 px-4 py-2.5 rounded-xl transition-all shadow-md shadow-radar-500/20 flex items-center gap-1.5 group/btn"
      >
        <span>{t('card.tryNow')}</span>
        <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </div>
  </div>
</article>
