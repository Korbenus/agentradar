---
import { useTranslations, type SupportedLang, defaultLang } from '../i18n/translations';
import { getLocalizedAgent } from '../i18n/agentData';
import { getLocalizedCategoryName } from '../utils/localizedCategories';

interface Props {
  agent: any;
  lang?: SupportedLang;
}

const { agent, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const localized = getLocalizedAgent(agent, lang);
const { name, tagline, category, rating, pricingModel, priceStartingAt, affiliateUrl, websiteUrl, badge, featured, aiActCompliant } = localized;
const targetUrl = affiliateUrl || websiteUrl;

const cleanSlug = (agent.id || agent.slug || '').replace(/\.md$/, '');
const detailUrl = lang === defaultLang ? `/agents/${cleanSlug}` : `/${lang}/agents/${cleanSlug}`;
const localizedCategory = getLocalizedCategoryName(category, lang);
---

<div class={`relative group flex flex-col justify-between p-6 rounded-2xl bg-gradient-to-b from-dark-900/90 to-dark-950/90 border transition-all duration-300 hover:shadow-2xl hover:-translate-y-1 ${
  featured 
    ? 'border-radar-500/40 from-radar-950/20 to-dark-900/90 shadow-radar-500/5 ring-1 ring-radar-500/30' 
    : 'border-dark-800 hover:border-radar-500/40 hover:shadow-radar-500/10'
}`}>
  <!-- Badges row -->
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-[11px] font-semibold px-2.5 py-1 rounded-lg bg-dark-800/90 text-slate-200 border border-dark-700">
        {localizedCategory}
      </span>
      {badge && (
        <span class="text-[11px] font-semibold px-2.5 py-1 rounded-lg bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
          ★ {badge}
        </span>
      )}
      {aiActCompliant && (
        <span class="text-[10px] font-semibold px-2 py-1 rounded-lg bg-blue-500/15 text-blue-300 border border-blue-500/30 flex items-center gap-1" title="EU AI Act compliant">
          <span>🇪🇺</span>
          <span>{t('card.aiActReady')}</span>
        </span>
      )}
    </div>

    <!-- Rating -->
    <div class="flex items-center gap-1 text-xs font-bold text-amber-300 bg-amber-400/15 border border-amber-400/30 px-2 py-1 rounded-lg shrink-0">
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
      <span>{rating.toFixed(1)}</span>
    </div>
  </div>

  <!-- Content -->
  <div>
    <h3 class="text-lg font-bold text-white group-hover:text-radar-400 transition-colors">
      <a href={detailUrl} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {name}
      </a>
    </h3>
    <p class="mt-2.5 text-xs sm:text-sm text-slate-400 line-clamp-2 leading-relaxed">
      {tagline}
    </p>
  </div>

  <!-- Pricing & Action row -->
  <div class="mt-6 pt-4 border-t border-dark-800/80 flex items-center justify-between z-10 relative">
    <div>
      <span class="text-[10px] uppercase font-bold text-slate-500 block">{t('card.pricing')}</span>
      <span class="text-xs font-extrabold text-slate-100">{priceStartingAt}</span>
      <span class="text-[10px] text-slate-400 block font-medium">{pricingModel}</span>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={detailUrl}
        class="text-xs font-medium text-slate-300 hover:text-white px-3.5 py-2 rounded-xl bg-dark-800/80 hover:bg-dark-750 border border-dark-700 transition"
      >
        {t('card.fullReview')}
      </a>
      <a
        href={targetUrl}
        target="_blank"
        rel="sponsored noopener noreferrer"
        class="text-xs font-bold text-black bg-gradient-to-r from-radar-400 to-emerald-400 hover:from-radar-300 hover:to-emerald-300 px-4 py-2 rounded-xl transition-all shadow-md shadow-radar-500/20 flex items-center gap-1 group/btn"
      >
        <span>{t('card.tryNow')}</span>
        <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </a>
    </div>
  </div>
</div>
