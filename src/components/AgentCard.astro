---
import { useTranslations, type SupportedLang, defaultLang } from '../i18n/translations';
import { getLocalizedAgent } from '../i18n/agentData';

interface Props {
  agent: any;
  lang?: SupportedLang;
}

const { agent, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const localized = getLocalizedAgent(agent, lang);
const { name, tagline, category, rating, pricingModel, priceStartingAt, affiliateUrl, websiteUrl, badge, featured, aiActCompliant } = localized;
const targetUrl = affiliateUrl || websiteUrl;

const cleanSlug = (agent.id || agent.slug || '').replace(/\.md$/, '');
const detailUrl = lang === defaultLang ? `/agents/${cleanSlug}` : `/${lang}/agents/${cleanSlug}`;
---

<div class={`relative group flex flex-col justify-between p-6 rounded-2xl bg-dark-900/80 border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 ${
  featured 
    ? 'border-radar-500/40 bg-gradient-to-b from-radar-950/20 to-dark-900/90 shadow-radar-500/5 ring-1 ring-radar-500/20' 
    : 'border-dark-800 hover:border-slate-700 hover:shadow-dark-950/50'
}`}>
  <!-- Badges row -->
  <div class="flex items-center justify-between gap-2 mb-4">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-slate-800/80 text-slate-300 border border-slate-700/60">
        {category}
      </span>
      {badge && (
        <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
          ★ {badge}
        </span>
      )}
      {aiActCompliant && (
        <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20" title="EU AI Act compliant">
          {t('card.aiActReady')}
        </span>
      )}
    </div>

    <!-- Rating -->
    <div class="flex items-center gap-1 text-xs font-semibold text-amber-400 bg-amber-400/10 px-2 py-0.5 rounded-md">
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
      <span>{rating.toFixed(1)}</span>
    </div>
  </div>

  <!-- Content -->
  <div>
    <h3 class="text-lg font-bold text-white group-hover:text-radar-400 transition-colors">
      <a href={detailUrl} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {name}
      </a>
    </h3>
    <p class="mt-2 text-xs sm:text-sm text-slate-400 line-clamp-2 leading-relaxed">
      {tagline}
    </p>
  </div>

  <!-- Pricing & Action row -->
  <div class="mt-6 pt-4 border-t border-dark-800/80 flex items-center justify-between z-10 relative">
    <div>
      <span class="text-[10px] uppercase font-semibold text-slate-500 block">{t('card.pricing')}</span>
      <span class="text-xs font-bold text-slate-200">{priceStartingAt}</span>
      <span class="text-[10px] text-slate-400 block">{pricingModel}</span>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={detailUrl}
        class="text-xs font-medium text-slate-300 hover:text-white px-3 py-1.5 rounded-lg bg-dark-800 hover:bg-dark-700 transition"
      >
        {t('card.fullReview')}
      </a>
      <a
        href={targetUrl}
        target="_blank"
        rel="sponsored noopener noreferrer"
        class="text-xs font-semibold text-black bg-radar-500 hover:bg-radar-400 px-3.5 py-1.5 rounded-lg transition-all shadow-md shadow-radar-500/20 flex items-center gap-1 group/btn"
      >
        <span>{t('card.tryNow')}</span>
        <svg class="w-3 h-3 group-hover/btn:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </a>
    </div>
  </div>
</div>
