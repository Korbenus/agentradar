---
import type { CollectionEntry } from 'astro:content';
import { getLocalizedAgent } from '../i18n/agentData';
import { defaultLang, type SupportedLang } from '../i18n/translations';
import { getLocalizedCategoryName } from '../utils/localizedCategories';
import { getAgentMonogram } from '../utils/brand';
import { editorialCopy, outbound } from '../lib/editorial';
interface Props { agent: CollectionEntry<'agents'>; lang?: SupportedLang }
const { agent, lang = defaultLang } = Astro.props;
const data = getLocalizedAgent(agent, lang);
const copy = editorialCopy(lang);
const link = outbound(agent.data);
const detailUrl = `${lang === defaultLang ? '' : `/${lang}`}/agents/${data.slug}`;
---
<article class="agent-card flex flex-col justify-between p-6 rounded-3xl bg-dark-900 border border-dark-800 shadow-sm space-y-5">
  <div class="space-y-4">
    <div class="flex items-start gap-3">
      <span class="w-12 h-12 rounded-xl bg-emerald-100 text-slate-900 font-bold flex items-center justify-center shrink-0" aria-hidden="true">{getAgentMonogram(data.name)}</span>
      <div class="min-w-0">
        <h3 class="text-xl font-bold text-white"><a href={detailUrl} class="hover:text-radar-400">{data.name}</a></h3>
        <p class="text-xs text-slate-400 mt-1">{getLocalizedCategoryName(data.category, lang)}</p>
      </div>
    </div>
    <p class="text-sm text-slate-200 leading-relaxed">{data.tagline}</p>
    <p class="text-xs text-radar-400">{copy.documentary}</p>
  </div>
  <div class="space-y-3 border-t border-dark-800 pt-4">
    <a href={data.pricingUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-slate-300 underline">{copy.pricing} ↗</a>
    <div class="flex flex-wrap gap-2">
      <a href={detailUrl} class="px-4 py-2.5 bg-dark-800 text-white rounded-xl text-sm font-bold border border-dark-700">{copy.profile}</a>
      <a href={link.url} target="_blank" rel={link.rel} class="px-4 py-2.5 bg-radar-400 text-slate-950 rounded-xl text-sm font-bold">{copy.visit} ↗</a>
    </div>
    {link.affiliate && <p class="text-xs text-slate-400">{copy.affiliate}</p>}
  </div>
</article>
