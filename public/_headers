/*
  # Protection anti-clickjacking : interdit l'intégration dans des iframes pirates
  X-Frame-Options: DENY

  # Empêche l'interprétation frauduleuse des types de fichiers (MIME sniffing)
  X-Content-Type-Options: nosniff

  # Contrôle des fuites de données HTTP Referrer
  Referrer-Policy: strict-origin-when-cross-origin

  # Désactive l'accès aux capteurs sensibles non utilisés (caméra, micro, localisation)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()

  # Force le protocole HTTPS strict pendant 1 an
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy (CSP) robuste
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:;
